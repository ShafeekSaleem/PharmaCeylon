NODE_ENV=development
PORT=3001

# Comma-separated browser origins allowed to call the API (CORS).
# Use the web app origin(s) (e.g. Next on :3000), not the API URL (:3001).
# If you open the site via LAN, add that origin too, e.g. http://192.168.1.10:3000
WEB_ORIGINS="http://localhost:3000"

# Set to true to log one JSON line per HTTP response (stdout)
# STRUCTURED_HTTP_LOG=true

# OpenAPI Swagger UI at /api/v1/docs (set to false to disable in this process)
# OPENAPI_ENABLED=true

# Default VAT % for checkout lines when taxAmount is omitted (0 = client must send tax or zero-rated)
# PRICING_VAT_RATE_PERCENT=0

# PostgreSQL connection string. RLS environments must use the non-owner
# NOBYPASSRLS application role here, never the migration owner.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmaceylon?schema=public"

# Request-scoped transaction carrier for PostgreSQL tenant settings.
TENANT_TRANSACTION_CONTEXT_ENABLED=false

# Set true only after Product, Batch, and Sale are ENABLE/FORCE RLS. When true,
# startup fails closed unless the transaction carrier, database role, and all
# three table flags are safe.
RLS_CANARY_ENFORCED=false

# Operations only: role name checked by the preparation/activation scripts.
# APP_DATABASE_ROLE=pharmaceylon_app

# JWT (use strong secrets in production)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Authorization cache (per-request user-context lookup). Bounds the staleness
# window for role/branch changes; 30s is a good default.
USER_CONTEXT_TTL_SECONDS=30

# httpOnly auth cookies (browser flow). Production: COOKIE_SECURE=true.
# COOKIE_SAMESITE=none requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.pharmaceylon.example

# Redis
REDIS_URL="redis://localhost:6379"

# prisma db seed — optional overrides (defaults are dev-only; change in production)
# SEED_OWNER_PASSWORD="Owner123!"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_MANAGER_PASSWORD="Manager123!"
# SEED_PHARMACIST_PASSWORD="Pharmacist123!"
# SEED_CASHIER_PASSWORD="Cashier123!"
# SEED_CLERK_PASSWORD="Clerk123!"

# Pre-tenant owner registration and email verification.
# Use a distinct strong secret; onboarding tokens are not normal tenant access tokens.
JWT_ONBOARDING_SECRET="change-me-onboarding"
JWT_ONBOARDING_TTL_SECONDS=86400
OWNER_VERIFICATION_TTL_MINUTES=30
PUBLIC_WEB_URL="http://localhost:3000"

# "console" logs the 6-digit verification code in development only.
# Production should use "resend" and configure the remaining values.
EMAIL_DELIVERY_MODE=console
# RESEND_API_KEY=
# EMAIL_FROM="PharmaCeylon <no-reply@example.com>"
