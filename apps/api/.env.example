NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmaceylon?schema=public"

# JWT (use strong secrets in production)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Redis
REDIS_URL="redis://localhost:6379"

# prisma db seed — optional overrides (defaults are dev-only; change in production)
# SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_CASHIER_PASSWORD="Cashier123!"
