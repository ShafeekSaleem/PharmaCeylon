generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  owner
  manager
  pharmacist
  cashier
  inventory_clerk
  /**
   * Sentinel for a UserBranchRole mapping that points at a tenant-defined custom Role (see `roleId`).
   */
  custom
}

enum NotificationCategory {
  inventory
  expiry
  purchasing
  transfers
  stocktakes
  sales
  compliance
  system
}

enum NotificationSeverity {
  info
  warning
  critical
}

enum PoStatus {
  draft
  pending_approval
  issued
  partially_received
  received
  short_closed
  cancelled
}

enum PoPriority {
  low
  normal
  high
  urgent
}

enum SaleStatus {
  posted
  voided
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash
  card
  mobile_wallet
  credit
}

enum TransferStatus {
  requested
  approved
  in_transit
  partially_received
  received
  rejected
  cancelled
}

enum GoodsReturnType {
  customer
  supplier
}

enum GoodsReturnStatus {
  draft
  pending_approval
  awaiting_logistics
  in_review
  completed
  rejected
  cancelled
}

enum StockMovementType {
  purchase_in
  sale_out
  customer_return_in
  supplier_return_out
  transfer_out
  transfer_in
  transfer_reserve_out
  transfer_reserve_release
  adjustment_in
  adjustment_out
  sale_void_in
  sale_refund_in
  quarantine_hold
  quarantine_release
  stocktake_in
  stocktake_out
}

enum StocktakeStatus {
  draft
  scheduled
  counting
  submitted
  under_review
  approved
  posted
  completed
  cancelled
}

enum StocktakeScope {
  full
  cycle
  near_expiry
  quarantined
  zero_stock
  custom
}

enum StocktakeMovementMode {
  continue_and_reconcile
  freeze_transactions
}

enum StocktakeCountStatus {
  pending
  counted
  submitted
  recount_requested
  recounted
  reviewed
  approved
  posted
}

enum StocktakeCondition {
  saleable
  damaged
  expired
  quarantined
  opened_pack
  missing_label
  temperature_affected
}

enum StocktakeVarianceReason {
  unrecorded_sale
  unrecorded_receipt
  damaged_stock
  expired_stock
  supplier_shortage
  wrong_batch_used
  unit_conversion_error
  transfer_not_recorded
  return_not_recorded
  counting_error
  suspected_theft_loss
  other
}

enum SupplierType {
  distributor
  importer
  manufacturer
  wholesaler
  other
}

enum SupplierStatus {
  active
  on_hold
  inactive
}

enum SupplierInvoiceStatus {
  open
  partial
  paid
  voided
}

/// Independent classification dimension a ProductCategory belongs to. COMMERCIAL is the
/// merchandising taxonomy (POS/Products "Category"); the other three are import-derived
/// regulatory facets and are never shown as tenant-editable merchandising categories.
enum CategoryDimension {
  COMMERCIAL
  DOSAGE_FORM
  NMRA_SCHEDULE
  REGISTRATION_TYPE
}

/// Where a ProductCategory row originated — drives edit/delete guardrails (e.g. system
/// template categories can be disabled but not renamed-away-from-canonical or deleted).
enum CategorySource {
  SYSTEM_TEMPLATE
  NMRA_IMPORT
  TENANT
  AUTO_CLASSIFIED
}

/// How a ProductCategoryMap row was created — provenance for category assignment, distinct
/// from CategorySource (which describes the category itself).
enum CategoryAssignmentSource {
  NMRA_IMPORT
  MANUAL
  AUTO_CLASSIFIED
  SYSTEM_DEFAULT
}

/// Where a Product's catalog record originated. NMRA-specific fields (schedule, regType,
/// dossierNo, registrationNo/Date) are only expected to be populated when source = NMRA.
enum CatalogSource {
  NMRA
  MANUAL
  SUPPLIER
  CSV_IMPORT
  BARCODE
}

/// Client-supplied idempotency keys (e.g. `Idempotency-Key` header) to avoid duplicate money mutations.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  scope          String   @db.VarChar(64)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId, scope, idempotencyKey])
  @@index([tenantId, scope, resourceId])
  @@map("idempotency_record")
}

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  legalName        String   @map("legal_name")
  displayName      String   @map("display_name")
  complianceRegion String   @map("compliance_region")
  timezone         String   @default("Asia/Colombo")
  isActive         Boolean  @default(true) @map("is_active")
  /// Tenant-configured gross margin % goal shown on Reports → Profitability → Gross Profit's
  /// goal tracker. Null until an owner/manager sets one in Settings — never defaulted/fabricated.
  targetGrossMarginPercent Decimal? @map("target_gross_margin_percent") @db.Decimal(5, 2)
  /// Operating defaults shown in Settings → General → Tenant Profile, apply across every branch.
  currency                String   @default("LKR")
  dateFormat              String   @default("DD/MM/YYYY") @map("date_format")
  fiscalYearStartMonth    Int      @default(1) @map("fiscal_year_start_month")
  businessRegistrationNo  String?  @map("business_registration_no")
  logoUrl                 String?  @map("logo_url")
  addressLine1            String?  @map("address_line1")
  addressLine2            String?  @map("address_line2")
  city                    String?
  postalCode              String?  @map("postal_code")
  email                   String?
  phone                   String?
  taxIdentificationNo     String?  @map("tax_identification_no")
  vatRegistrationNo       String?  @map("vat_registration_no")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  branches         Branch[]
  users            AppUser[]
  userBranchRoles  UserBranchRole[]
  auditEvents      AuditEvent[]
  suppliers        Supplier[]
  supplierInvoices SupplierInvoice[]
  customers        Customer[]
  roles            Role[]
  settings         TenantSettings?
  notifications    Notification[]
  notificationPreferences NotificationPreference[]

  @@map("tenant")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  timezone     String
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  district     String?
  postalCode   String?  @map("postal_code")
  phone        String?
  email        String?
  pharmacyLicenceNo      String?   @map("pharmacy_licence_no")
  pharmacyLicenceExpiry  DateTime? @map("pharmacy_licence_expiry") @db.Date
  responsiblePharmacist  String?   @map("responsible_pharmacist")
  pharmacistSlmcNo       String?   @map("pharmacist_slmc_no")
  openingHours           String?   @map("opening_hours")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  userBranchRoles   UserBranchRole[]
  batches           Batch[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  sales             Sale[]
  ledgerEntries     StockLedger[]
  transfersFrom     Transfer[]            @relation("TransferFromBranch")
  transfersTo       Transfer[]            @relation("TransferToBranch")
  goodsReturns      GoodsReturn[]
  stocktakes        Stocktake[]
  documentSequences DocumentSequence[]
  supplierInvoices  SupplierInvoice[]
  auditEvents       AuditEvent[]
  prescriptions     Prescription[]
  heldSales         HeldSale[]
  monthlyTargets    BranchMonthlyTarget[]
  notifications     Notification[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branch")
}

/// Owner-set monthly sales target for a branch; optional manager accountable for achievement.
model BranchMonthlyTarget {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  /// Calendar month key, e.g. "2026-08" (Asia/Colombo month).
  yearMonth     String   @map("year_month") @db.VarChar(7)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(14, 2)
  managerUserId String?  @map("manager_user_id") @db.Uuid
  notes         String?  @db.VarChar(256)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  manager AppUser? @relation("BranchTargetManager", fields: [managerUserId], references: [id])
  creator AppUser? @relation("BranchTargetCreator", fields: [createdBy], references: [id])

  @@unique([tenantId, branchId, yearMonth])
  @@index([tenantId, yearMonth])
  @@index([tenantId, managerUserId])
  @@map("branch_monthly_target")
}

/// Tenant-wide feature defaults and policy toggles surfaced across Settings → Modules /
/// Alerts & Approvals / Security & Access. One row per tenant, lazily created on first
/// read/write via upsert (see TenantSettingsService) — every column has a sensible default
/// so a tenant with no row yet still resolves to sane behavior.
model TenantSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // ── Dashboard widgets (Settings → Modules → Main) ──
  showSalesTodayWidget        Boolean @default(true) @map("show_sales_today_widget")
  showLowStockWidget          Boolean @default(true) @map("show_low_stock_widget")
  showExpiringBatchesWidget   Boolean @default(true) @map("show_expiring_batches_widget")
  showTopProductsWidget       Boolean @default(true) @map("show_top_products_widget")
  showRecentActivityWidget    Boolean @default(false) @map("show_recent_activity_widget")
  showBranchPerformanceWidget Boolean @default(true) @map("show_branch_performance_widget")

  // ── POS / checkout defaults (Settings → Modules → Main) ──
  posQuickAddEnabled      Boolean @default(true) @map("pos_quick_add_enabled")
  posHeldSalesEnabled     Boolean @default(true) @map("pos_held_sales_enabled")
  posRequireCustomer      Boolean @default(false) @map("pos_require_customer")
  posAutoPrintReceipt     Boolean @default(true) @map("pos_auto_print_receipt")
  posDefaultPaymentMethod String  @default("cash") @map("pos_default_payment_method")
  posMaxDiscountPercent   Decimal @default(10) @db.Decimal(5, 2) @map("pos_max_discount_percent")

  // ── Receipt & invoice customization (Settings → Modules → Main) ──
  receiptPaperSize         String  @default("80mm") @map("receipt_paper_size")
  receiptCopies            Int     @default(1) @map("receipt_copies")
  receiptHeaderText        String? @map("receipt_header_text")
  receiptFooterText        String? @map("receipt_footer_text")
  receiptShowLogo          Boolean @default(true) @map("receipt_show_logo")
  receiptShowVatBreakdown  Boolean @default(true) @map("receipt_show_vat_breakdown")
  receiptShowStaffName     Boolean @default(true) @map("receipt_show_staff_name")
  receiptShowLoyaltyPoints Boolean @default(false) @map("receipt_show_loyalty_points")

  // ── Product display (Settings → Modules → Catalog) ──
  defaultProductView         String  @default("grid") @map("default_product_view")
  showControlledBadgeInLists Boolean @default(true) @map("show_controlled_badge_in_lists")

  // ── Tax configuration (Settings → Modules → Catalog) ──
  /// Overrides PRICING_VAT_RATE_PERCENT when set; env var stays the fallback when null.
  vatRatePercent               Decimal? @db.Decimal(5, 2) @map("vat_rate_percent")
  vatCalculationMethod         String   @default("exclusive") @map("vat_calculation_method")
  prescriptionTaxExempt        Boolean  @default(true) @map("prescription_tax_exempt")
  showTaxBreakdownOnDocuments  Boolean  @default(true) @map("show_tax_breakdown_on_documents")

  // ── Inventory & stock policies (Settings → Modules → Operations) ──
  lowStockThresholdUnits          Int     @default(20) @map("low_stock_threshold_units")
  expiryWarningDays               Int     @default(30) @map("expiry_warning_days")
  defaultStockView                String  @default("batch") @map("default_stock_view")
  stockPickingMethod              String  @default("fefo") @map("stock_picking_method")
  barcodeAdjustmentsEnabled       Boolean @default(true) @map("barcode_adjustments_enabled")
  blockExpiredBatchSalesAtPos     Boolean @default(true) @map("block_expired_batch_sales_at_pos")
  requireBatchExpiryOnGoodsReceipt Boolean @default(true) @map("require_batch_expiry_on_goods_receipt")
  allowNegativeStock               Boolean @default(false) @map("allow_negative_stock")

  // ── Purchasing defaults (Settings → Modules → Operations) ──
  poNumberPrefix                 String  @default("PO-") @map("po_number_prefix")
  defaultSupplierPaymentTermsDays Int     @default(30) @map("default_supplier_payment_terms_days")
  autoReceiveOnInvoiceMatch       Boolean @default(false) @map("auto_receive_on_invoice_match")

  // ── Transfers & returns defaults (Settings → Modules → Operations) ──
  defaultReturnWindowDays   Int     @default(14) @map("default_return_window_days")
  requireTransferReasonNote Boolean @default(true) @map("require_transfer_reason_note")

  // ── Stocktake defaults (Settings → Modules → Operations) ──
  stocktakeDefaultCountMethod      String  @default("full") @map("stocktake_default_count_method")
  stocktakeVarianceTolerancePercent Decimal @default(2) @db.Decimal(5, 2) @map("stocktake_variance_tolerance_percent")

  // ── Alerts: recipients & channels ──
  alertEmailDigestEnabled   Boolean @default(true)  @map("alert_email_digest_enabled")
  alertNotifyOwner          Boolean @default(true)  @map("alert_notify_owner")
  alertNotifyManager        Boolean @default(true)  @map("alert_notify_manager")
  alertNotifyPharmacist     Boolean @default(false) @map("alert_notify_pharmacist")
  alertNotifyInventoryClerk Boolean @default(true)  @map("alert_notify_inventory_clerk")

  // ── Approval rules ──
  approvalRequiredPurchaseOrderThreshold Decimal? @db.Decimal(14, 2) @map("approval_required_po_threshold")
  approvalRequiredForBranchTransfers     Boolean  @default(true) @map("approval_required_for_branch_transfers")
  approvalRequiredReturnThreshold        Decimal? @db.Decimal(14, 2) @map("approval_required_return_threshold")

  // ── Insights & reports ──
  defaultReportPeriod       String  @default("this_month") @map("default_report_period")
  showFootfallAnalytics     Boolean @default(true)  @map("show_footfall_analytics")
  weeklySummaryEmailEnabled Boolean @default(false) @map("weekly_summary_email_enabled")

  // ── Security policy ──
  sessionTimeoutMinutes         Int     @default(30)  @map("session_timeout_minutes")
  auditLogRetentionDays         Int     @default(365) @map("audit_log_retention_days")
  passwordMinLength             Int     @default(8)   @map("password_min_length")
  passwordRequireNumberOrSymbol Boolean @default(true) @map("password_require_number_or_symbol")
  passwordExpiryDays            Int     @default(0)   @map("password_expiry_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model AppUser {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// Globally unique — login resolves tenant from this email alone (subdomains may refine UX later).
  email                String    @unique
  fullName             String    @map("full_name")
  phone                String?   @map("phone")
  avatarUrl            String?   @map("avatar_url")
  passwordHash         String    @map("password_hash")
  /// Optional short till PIN (bcrypt). Used for pharmacist co-sign at POS without switching sessions.
  posPinHash           String?   @map("pos_pin_hash")
  failedPosPinAttempts Int       @default(0) @map("failed_pos_pin_attempts")
  posPinLockedUntil    DateTime? @map("pos_pin_locked_until")
  /// Bumped on logout-all, password change, role change, or detected refresh-reuse.
  /// Embedded in every access JWT; mismatch ⇒ 401.
  tokenVersion         Int       @default(0) @map("token_version")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  userBranchRoles        UserBranchRole[]
  sessions               Session[]
  purchaseOrdersCreated  PurchaseOrder[]        @relation("PurchaseOrderCreator")
  goodsReceiptsReceived  GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  sales                  Sale[]                 @relation("SaleSeller")
  salesDispensed         Sale[]                 @relation("SaleDispenser")
  ledgerEntriesCreated   StockLedger[]          @relation("StockLedgerActor")
  transfersRequested     Transfer[]             @relation("TransferRequester")
  transfersApproved      Transfer[]             @relation("TransferApprover")
  transfersReceived      Transfer[]             @relation("TransferReceiver")
  goodsReturnsRequested  GoodsReturn[]          @relation("GoodsReturnRequester")
  goodsReturnsApproved   GoodsReturn[]          @relation("GoodsReturnApprover")
  goodsReturnsProcessed  GoodsReturn[]          @relation("GoodsReturnProcessor")
  stocktakesCounted      Stocktake[]            @relation("StocktakeCounter")
  stocktakesAssigned     StocktakeAssignment[]
  branchTargetsManaged   BranchMonthlyTarget[]  @relation("BranchTargetManager")
  branchTargetsCreated   BranchMonthlyTarget[]  @relation("BranchTargetCreator")
  stocktakesReviewed     Stocktake[]            @relation("StocktakeReviewer")
  stocktakesApproved     Stocktake[]            @relation("StocktakeApprover")
  stocktakesPosted       Stocktake[]            @relation("StocktakePoster")
  stocktakesCompleted    Stocktake[]            @relation("StocktakeCompleter")
  stocktakeCountEntries  StocktakeCountEntry[]
  stocktakePostings      StocktakePosting[]
  stocktakeLineReviews   StocktakeLine[]        @relation("StocktakeLineReviewer")
  stocktakeLineApprovals StocktakeLine[]        @relation("StocktakeLineApprover")
  stocktakePostingLines  StocktakePostingLine[]
  auditEvents            AuditEvent[]           @relation("AuditActor")
  prescriptionsCreated   Prescription[]         @relation("PrescriptionCreator")
  heldSales              HeldSale[]             @relation("HeldSaleHolder")
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@index([tenantId])
  @@map("app_user")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  branchId        String?              @map("branch_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  category        NotificationCategory
  severity        NotificationSeverity @default(info)
  title           String               @db.VarChar(180)
  message         String?              @db.VarChar(600)
  actionLabel     String?              @map("action_label") @db.VarChar(80)
  actionHref      String?              @map("action_href") @db.VarChar(500)
  entityType      String?              @map("entity_type") @db.VarChar(80)
  entityId        String?              @map("entity_id") @db.Uuid
  dedupeKey       String               @map("dedupe_key") @db.VarChar(240)
  source          String               @default("domain_event") @db.VarChar(80)
  metadata        Json?
  requiresAction  Boolean              @default(false) @map("requires_action")
  readAt          DateTime?            @map("read_at")
  archivedAt      DateTime?            @map("archived_at")
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipient AppUser @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, recipientUserId, dedupeKey])
  @@index([tenantId, recipientUserId, archivedAt, resolvedAt, createdAt(sort: Desc)])
  @@index([tenantId, recipientUserId, readAt])
  @@index([tenantId, branchId, category])
  @@map("notification")
}

model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  inventoryEnabled     Boolean  @default(true) @map("inventory_enabled")
  expiryEnabled        Boolean  @default(true) @map("expiry_enabled")
  purchasingEnabled    Boolean  @default(true) @map("purchasing_enabled")
  transfersEnabled     Boolean  @default(true) @map("transfers_enabled")
  stocktakesEnabled    Boolean  @default(true) @map("stocktakes_enabled")
  salesEnabled         Boolean  @default(true) @map("sales_enabled")
  complianceEnabled    Boolean  @default(true) @map("compliance_enabled")
  systemEnabled        Boolean  @default(true) @map("system_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notification_preference")
}

/// Refresh-token-backed session. One row per issued refresh token.
/// Rotation: on refresh we create a new row sharing `familyId`, mark the old
/// row revoked with `replacedById` pointing at the new one. Reuse of a revoked
/// row triggers revocation of every row in the family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid

  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  role      RoleName
  /**
   * FK to the tenant-scoped Role row driving permission resolution.
   * For built-in roles this points at that tenant's seeded system Role
   * (kept in sync with `role`); for `role: custom` it points at the
   * tenant's custom Role. `role` itself stays authoritative for the
   * hardcoded owner-bypass safety check in the guard — never removed.
   */
  roleId    String?  @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    AppUser @relation(fields: [userId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  roleRef Role?   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, branchId, role])
  @@map("user_branch_role")
}

model Permission {
  /**
   * Global catalog — not tenant-scoped. Seeded from `security/permission-catalog.ts`.
   */
  key         String   @id
  module      String
  label       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /**
   * Stable slug: matches the RoleName enum value for built-ins, or a generated slug for custom roles.
   */
  key         String
  name        String
  description String?
  /**
   * True for the 6 seeded built-in roles; false for tenant-created custom roles.
   */
  isSystem    Boolean  @default(false) @map("is_system")
  /**
   * True only for the "owner" role row. Permissions on a locked role can't
   * be edited and the role can't be deleted/renamed — prevents a tenant
   * from ever locking out all owners.
   */
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  permissions     RolePermission[]
  userBranchRoles UserBranchRole[]

  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([roleId, permissionKey])
  @@map("role_permission")
}

model Supplier {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  code             String
  name             String
  type             SupplierType   @default(distributor)
  status           SupplierStatus @default(active)
  phone            String?
  email            String?
  contactName      String?        @map("contact_name")
  leadTimeDays     Int            @default(2) @map("lead_time_days")
  paymentTermsDays Int            @default(30) @map("payment_terms_days")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReturns   GoodsReturn[]
  invoices       SupplierInvoice[]
  batches        Batch[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("supplier")
}

model SupplierInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  supplierId     String                @map("supplier_id") @db.Uuid
  branchId       String?               @map("branch_id") @db.Uuid
  invoiceNumber  String                @map("invoice_number")
  goodsReceiptId String?               @unique @map("goods_receipt_id") @db.Uuid
  invoiceDate    DateTime              @map("invoice_date") @db.Date
  dueDate        DateTime              @map("due_date") @db.Date
  totalAmount    Decimal               @map("total_amount") @db.Decimal(14, 2)
  paidAmount     Decimal               @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status         SupplierInvoiceStatus @default(open)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("supplier_invoice")
}

model Product {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  sku                  String
  barcode              String?
  name                 String
  brandName            String?   @map("brand_name")
  genericName          String?   @map("generic_name")
  manufacturer         String?
  dosageForm           String?   @map("dosage_form")
  strength             String?
  unit                 String?
  packSize             String?   @map("pack_size")
  /// NMRA pack type (blister, vial, bottle, etc.).
  packType             String?   @map("pack_type")
  storage              String?
  shelfLife            String?   @map("shelf_life")
  taxCategory          String?   @map("tax_category")
  imageUrl             String?   @map("image_url")
  /// NMRA registration number (REG.NO.).
  registrationNo       String?   @map("registration_no")
  registrationDate     DateTime? @map("registration_date") @db.Date
  /// NMRA schedule classification (I, IIA, IIB, IIC, III, …).
  schedule             String?
  /// NMRA registration type (Full, Two Years, Provisional).
  regType              String?   @map("reg_type")
  dossierNo            String?   @map("dossier_no")
  countryOfOrigin      String?   @map("country_of_origin")
  /// Local marketing authorisation holder / agent in Sri Lanka.
  localAgent           String?   @map("local_agent")
  /// Schedule / narcotic-class — needs pharmacist dispense authority (PIN or elevated session).
  isControlled         Boolean   @default(false) @map("is_controlled")
  /// Needs a linked prescription to sell (antibiotics etc.). Controlled always implies this.
  requiresPrescription Boolean   @default(false) @map("requires_prescription")
  reorderLevel         Int       @default(0) @map("reorder_level")
  isActive             Boolean   @default(true) @map("is_active")
  /// Catalog record origin. NMRA-specific fields are only expected when source = NMRA —
  /// MANUAL/SUPPLIER/CSV_IMPORT/BARCODE retail products may leave them null.
  source               CatalogSource @default(MANUAL)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  batches                Batch[]
  purchaseItems          PurchaseOrderItem[]
  receiptItems           GoodsReceiptItem[]
  saleItems              SaleItem[]
  ledgerEntries          StockLedger[]
  transferItems          TransferItem[]
  returnItems            GoodsReturnItem[]
  stocktakeLines         StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]
  tagMaps                ProductTagMap[]
  aliases                ProductAlias[]
  categoryMaps           ProductCategoryMap[]
  similarities           ProductSimilarity[]     @relation("ProductSimilarityProduct")
  similarTo              ProductSimilarity[]     @relation("ProductSimilaritySimilar")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@index([tenantId, brandName])
  @@index([tenantId, genericName])
  @@index([tenantId, name])
  @@index([tenantId, registrationNo])
  @@index([tenantId, schedule])
  @@index([tenantId, source])
  @@map("product")
}

model ProductCategory {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  /// Which classification axis this category belongs to. COMMERCIAL is the only dimension
  /// tenants manage via Settings → Catalog → Categories; the others are import-derived.
  dimension        CategoryDimension @default(DOSAGE_FORM)
  name             String
  parentCategoryId String?           @map("parent_category_id") @db.Uuid
  /// Stable SaaS-level identity for predefined COMMERCIAL categories (e.g. "MEDICINES_PAIN_FEVER").
  /// Null for tenant-created custom categories and for non-COMMERCIAL dimension rows. Never used
  /// for display — display names may be renamed per tenant without breaking reporting/history.
  canonicalKey     String?           @map("canonical_key")
  source           CategorySource    @default(TENANT)
  /// True for the seeded commercial template and NMRA-import taxonomy roots/children — governs
  /// whether a tenant can rename/delete vs. only enable/disable.
  isSystem         Boolean           @default(false) @map("is_system")
  /// Whether this category is enabled for the tenant. Standard (isSystem) categories the tenant
  /// hasn't opted into stay inactive rather than being deleted, so they remain available to
  /// enable later. Disabling never cascades — historical ProductCategoryMap rows are preserved.
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  parent       ProductCategory?     @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children     ProductCategory[]    @relation("CategoryHierarchy")
  categoryMaps ProductCategoryMap[]

  @@unique([tenantId, dimension, name, parentCategoryId])
  @@unique([tenantId, canonicalKey])
  @@index([tenantId, dimension])
  @@index([tenantId, dimension, isActive])
  @@index([tenantId, parentCategoryId])
  @@index([tenantId, canonicalKey])
  @@map("product_category")
}

model ProductTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tagMaps ProductTagMap[]

  @@unique([tenantId, name])
  @@map("product_tag")
}

model ProductTagMap {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, tagId])
  @@index([tenantId, productId])
  @@map("product_tag_map")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  aliasText String   @map("alias_text")
  aliasType String   @default("synonym") @map("alias_type")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, aliasText])
  @@index([tenantId, aliasText])
  @@map("product_alias")
}

model ProductSimilarity {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  similarProductId String   @map("similar_product_id") @db.Uuid
  score            Decimal  @db.Decimal(5, 4)
  reasonCode       String   @map("reason_code")
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product @relation("ProductSimilarityProduct", fields: [productId], references: [id], onDelete: Cascade)
  similarProduct Product @relation("ProductSimilaritySimilar", fields: [similarProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, similarProductId, reasonCode])
  @@map("product_similarity")
}

model ProductCategoryMap {
  id         String                   @id @default(uuid()) @db.Uuid
  tenantId   String                   @map("tenant_id") @db.Uuid
  productId  String                   @map("product_id") @db.Uuid
  categoryId String                   @map("category_id") @db.Uuid
  /// Denormalized copy of `category.dimension`, set at write time by the service layer.
  /// Lets the DB enforce "at most one primary COMMERCIAL category per product" via a partial
  /// unique index (see migration SQL) without a join, and lets report queries filter by
  /// dimension without joining ProductCategory on every row.
  dimension  CategoryDimension
  /// For COMMERCIAL: the product's single primary merchandising category — all financial/
  /// profitability reporting groups by this so a product is never double counted. Secondary
  /// COMMERCIAL maps (isPrimary = false) are for discovery only. Always true for non-COMMERCIAL
  /// dimensions (Schedule/Form/RegType don't have a primary/secondary concept).
  isPrimary        Boolean                  @default(true) @map("is_primary")
  assignmentSource CategoryAssignmentSource @default(MANUAL) @map("assignment_source")
  /// AI-suggested-mapping confidence (0–1), only meaningful when assignmentSource = AUTO_CLASSIFIED.
  confidence Decimal? @db.Decimal(4, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, categoryId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
  @@index([tenantId, productId, dimension])
  @@map("product_category_map")
}

model DocumentSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  docType   String   @map("doc_type") @db.VarChar(32)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, docType])
  @@map("document_sequence")
}

model Batch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  batchNo          String    @map("batch_no")
  expiryDate       DateTime  @map("expiry_date") @db.Date
  costPrice        Decimal   @map("cost_price") @db.Decimal(12, 2)
  sellingPrice     Decimal   @map("selling_price") @db.Decimal(12, 2)
  isQuarantined    Boolean   @default(false) @map("is_quarantined")
  quarantinedAt    DateTime? @map("quarantined_at")
  quarantineReason String?   @map("quarantine_reason") @db.VarChar(512)
  /// Direct supplier reference, set at batch-creation time (goods receipt: from the PO's
  /// supplier; manual stock adjustment: whoever entered it may tag one, since not every
  /// opening-stock/adjustment batch has a PO behind it). Nullable — supplier is genuinely
  /// unknown for some manually-entered batches. This is the authoritative lookup for "who
  /// supplied this batch"; `GoodsReceiptItem → GoodsReceipt → PurchaseOrder → Supplier` is a
  /// fallback for batches created before this column existed, not a replacement for it.
  supplierId       String?   @map("supplier_id") @db.Uuid
  receivedAt       DateTime  @default(now()) @map("received_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  receiptItems           GoodsReceiptItem[]
  saleItems              SaleItem[]
  ledgerEntries          StockLedger[]
  transferItems          TransferItem[]
  returnItems            GoodsReturnItem[]
  stocktakeLines         StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]

  @@unique([tenantId, branchId, productId, batchNo])
  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, isQuarantined])
  @@index([tenantId, supplierId])
  @@map("batch")
}

model PurchaseOrder {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  branchId             String     @map("branch_id") @db.Uuid
  supplierId           String     @map("supplier_id") @db.Uuid
  poNumber             String     @map("po_number")
  status               PoStatus   @default(draft)
  priority             PoPriority @default(normal)
  expectedOn           DateTime?  @map("expected_on") @db.Date
  supplierReference    String?    @map("supplier_reference") @db.VarChar(128)
  notes                String?
  deliveryInstructions String?    @map("delivery_instructions")
  paymentTermsDays     Int        @default(30) @map("payment_terms_days")
  shippingCharges      Decimal    @default(0) @map("shipping_charges") @db.Decimal(12, 2)
  createdBy            String     @map("created_by") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  branch   Branch   @relation(fields: [branchId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  creator  AppUser  @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  goodsReturns  GoodsReturn[]

  @@unique([tenantId, branchId, poNumber])
  @@index([tenantId, branchId, status])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  orderedQty      Int      @map("ordered_qty")
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal  @default(18) @map("tax_percent") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_item")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  receivedOn      DateTime @map("received_on") @db.Date
  receivedBy      String   @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  branch        Branch        @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiver      AppUser       @relation("GoodsReceiptReceiver", fields: [receivedBy], references: [id])

  items           GoodsReceiptItem[]
  goodsReturns    GoodsReturn[]
  supplierInvoice SupplierInvoice?

  @@unique([tenantId, branchId, grnNumber])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  goodsReceiptId String   @map("goods_receipt_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  receivedQty    Int      @map("received_qty")
  createdAt      DateTime @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])

  @@map("goods_receipt_item")
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  branchId       String     @map("branch_id") @db.Uuid
  invoiceNo      String     @map("invoice_no")
  status         SaleStatus @default(posted)
  soldAt         DateTime   @default(now()) @map("sold_at")
  subtotal       Decimal    @db.Decimal(12, 2)
  discountTotal  Decimal    @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal    @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal     Decimal    @map("grand_total") @db.Decimal(12, 2)
  amountPaid     Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  changeDue      Decimal    @default(0) @map("change_due") @db.Decimal(12, 2)
  customerId     String?    @map("customer_id") @db.Uuid
  prescriptionId String?    @map("prescription_id") @db.Uuid
  notes          String?    @db.VarChar(512)
  soldBy         String     @map("sold_by") @db.Uuid
  /// Pharmacist/manager/owner who authorised controlled dispense (self or PIN co-sign).
  dispensedBy    String?    @map("dispensed_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")

  branch       Branch        @relation(fields: [branchId], references: [id])
  seller       AppUser       @relation("SaleSeller", fields: [soldBy], references: [id])
  dispenser    AppUser?      @relation("SaleDispenser", fields: [dispensedBy], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])

  items        SaleItem[]
  payments     SalePayment[]
  goodsReturns GoodsReturn[]

  @@unique([tenantId, branchId, invoiceNo])
  @@index([tenantId, branchId, soldAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@index([tenantId, dispensedBy])
  @@map("sale")
}

/// Walk-in or registered buyer. Optional on a sale — POS defaults to walk-in.
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?  @db.VarChar(32)
  email     String?
  address   String?  @db.VarChar(512)
  notes     String?  @db.VarChar(512)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  sales         Sale[]
  prescriptions Prescription[]

  @@unique([tenantId, phone])
  @@index([tenantId, fullName])
  @@map("customer")
}

/// Doctor's prescription captured at the counter; required to dispense controlled medicines.
model Prescription {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  rxNumber    String    @map("rx_number") @db.VarChar(64)
  patientName String    @map("patient_name")
  doctorName  String    @map("doctor_name")
  doctorRegNo String?   @map("doctor_reg_no") @db.VarChar(64)
  issuedOn    DateTime  @map("issued_on") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  notes       String?   @db.VarChar(512)
  customerId  String?   @map("customer_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  creator  AppUser   @relation("PrescriptionCreator", fields: [createdBy], references: [id])
  sales    Sale[]

  @@unique([tenantId, branchId, rxNumber])
  @@index([tenantId, branchId, issuedOn(sort: Desc)])
  @@map("prescription")
}

/// Tender lines for a posted sale — one row per method so split payments are auditable.
model SalePayment {
