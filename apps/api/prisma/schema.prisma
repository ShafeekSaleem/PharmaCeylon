  supplier
}

enum GoodsReturnStatus {
  draft
  pending_approval
  awaiting_logistics
  in_review
  completed
  rejected
  cancelled
}

enum StockMovementType {
  purchase_in
  sale_out
  customer_return_in
  supplier_return_out
  transfer_out
  transfer_in
  /// Historical only. Reservations used to be written as ledger movements, which took reserved
  /// units off "on hand" while they were still on the shelf. They now live in
  /// `StockReservation`; these two values stay so old rows keep their meaning.
  transfer_reserve_out
  transfer_reserve_release
  adjustment_in
  adjustment_out
  /// Day-one balance brought in from a previous system, not a later correction. Kept distinct
  /// from adjustment_in because stock valuation, shrinkage analysis and the first stocktake all
  /// need to tell the two apart, and once recorded as an adjustment that difference is gone.
  opening_stock
  sale_void_in
  sale_refund_in
  quarantine_hold
  quarantine_release
  stocktake_in
  stocktake_out
}

/// Which pile a ledger row moves units in or out of. On hand is the sum of every row regardless
/// of bucket; quarantined is the sum of `quarantine` rows. Quarantining is therefore a pair of
/// rows that nets to zero on hand — the units never left the branch, they stopped being sellable.
enum StockBucket {
  sellable
  quarantine
}

enum StockReservationStatus {
  active
  released
  consumed
}

enum StocktakeStatus {
  draft
  scheduled
  counting
  submitted
  under_review
  approved
  posted
  completed
  cancelled
}

enum StocktakeScope {
  full
  cycle
  near_expiry
  quarantined
  zero_stock
  custom
}

enum StocktakeMovementMode {
  continue_and_reconcile
  freeze_transactions
}

enum StocktakeCountStatus {
  pending
  counted
  submitted
  recount_requested
  recounted
  reviewed
  approved
  posted
}

enum StocktakeCondition {
  saleable
  damaged
  expired
  quarantined
  opened_pack
  missing_label
  temperature_affected
}

enum StocktakeVarianceReason {
  unrecorded_sale
  unrecorded_receipt
  damaged_stock
  expired_stock
  supplier_shortage
  wrong_batch_used
  unit_conversion_error
  transfer_not_recorded
  return_not_recorded
  counting_error
  suspected_theft_loss
  other
}

enum SupplierType {
  distributor
  importer
  manufacturer
  wholesaler
  other
}

enum SupplierStatus {
  active
  on_hold
  inactive
}

enum SupplierInvoiceStatus {
  open
  partial
  paid
  voided
}

/// Independent classification dimension a ProductCategory belongs to. COMMERCIAL is the
/// merchandising taxonomy (POS/Products "Category"); the other three are import-derived
/// regulatory facets and are never shown as tenant-editable merchandising categories.
enum CategoryDimension {
  COMMERCIAL
  DOSAGE_FORM
  NMRA_SCHEDULE
  REGISTRATION_TYPE
}

/// Where a ProductCategory row originated — drives edit/delete guardrails (e.g. system
/// template categories can be disabled but not renamed-away-from-canonical or deleted).
enum CategorySource {
  SYSTEM_TEMPLATE
  NMRA_IMPORT
  TENANT
  AUTO_CLASSIFIED
}

/// How a ProductCategoryMap row was created — provenance for category assignment, distinct
/// from CategorySource (which describes the category itself).
enum CategoryAssignmentSource {
  NMRA_IMPORT
  MANUAL
  AUTO_CLASSIFIED
  SYSTEM_DEFAULT
  /// Adopted wholesale from a reference row's own regulatory/commercial categories when a
  /// shop product was linked to it — distinct from NMRA_IMPORT, which is the register file
  /// itself, not a deliberate per-product link action.
  NMRA_LINK
}

/// Where a Product's catalog record originated. NMRA-specific fields (schedule, regType,
/// dossierNo, registrationNo/Date) are only expected to be populated when source = NMRA.
/// What kind of decision a `CatalogTask` is waiting on. One queue, many task shapes — the
/// Work Queue is the single place a pharmacist finds catalog work, rather than one screen per
/// task type as it used to be (Organize for categories, Register matches for NMRA).
enum CatalogTaskType {
  /// The product has no primary commercial category, or is parked in the Unclassified floor.
  MISSING_CATEGORY
  /// The product looks like a registered medicine and a register row matches it.
  NMRA_MATCH
  /// An identifier (barcode / registration no.) points at more than one register row, so no
  /// single match can be chosen without a person looking. Never auto-linked.
  NMRA_AMBIGUOUS
  /// An import row collided with an existing product on an identifier.
  IMPORT_DUPLICATE
}

/// The durable lifecycle of a catalog task. `OPEN` and `NEEDS_REVIEW` are the two states that
/// count as outstanding work; the other three are terminal and keep the row as history so the
/// same task is never regenerated and quietly re-asked.
enum CatalogTaskStatus {
  OPEN
  /// Compliance-sensitive or ambiguous — deliberately excluded from bulk "apply safe changes".
  NEEDS_REVIEW
  RESOLVED
  DISMISSED
  /// "This isn't a medicine" — the escape hatch that stops an umbrella sitting in the NMRA
  /// queue forever. Also written automatically by the eligibility classifier.
  NOT_APPLICABLE
}

enum CatalogSource {
  NMRA
  MANUAL
  SUPPLIER
  CSV_IMPORT
  BARCODE
}

enum ProductImportStatus {
  running
  completed
  failed
  undone
}

/// One run of the "bring your own product list" importer.
///
/// The in-memory job map carries live progress; this row is the durable record, so an import
/// can still be audited and undone after a restart. Products and stock created by the run are
/// stamped with its id (`Product.importId`, and `StockLedger.referenceId` with
/// `referenceType = "product_import"`), which is what makes undo possible.
model ProductImport {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  /// Where opening stock was posted. Null when the file carried products only.
  branchId  String? @map("branch_id") @db.Uuid
  /// Who ran it — an import can create thousands of rows, so this is never anonymous.
  createdBy String  @map("created_by") @db.Uuid

  filename String
  status   ProductImportStatus @default(running)

  /// The column mapping the user confirmed on screen, kept so a failed run can be explained.
  mapping Json @default("{}")

  productsCreated   Int @default(0) @map("products_created")
  productsUpdated   Int @default(0) @map("products_updated")
  productsRanged    Int @default(0) @map("products_ranged")
  batchesCreated    Int @default(0) @map("batches_created")
  unitsPosted       Int @default(0) @map("units_posted")
  rowsFailed        Int @default(0) @map("rows_failed")
  /// Batches accepted without a real expiry date, awaiting review.
  expiryReviewCount Int @default(0) @map("expiry_review_count")

  /// Rows that could not be imported, in the shape the downloadable error CSV needs.
  result      Json?
  requestFingerprint String? @map("request_fingerprint") @db.VarChar(64)
  errorReport Json?   @map("error_report")
  error       String?

  /// Live progress, mirrored from the job runner so any API instance (or a page reloaded
  /// after a restart) can answer "how far did it get" without the originating process.
  phase         String? @db.VarChar(32)
  rowsProcessed Int     @default(0) @map("rows_processed")
  rowsTotal     Int     @default(0) @map("rows_total")

  /// Bumped by the running job every few hundred rows. A `running` row whose heartbeat has
  /// gone stale was interrupted (restart, crash, deploy) and is swept to `failed` — the state
  /// that lets an operator re-run it — rather than being left running forever.
  heartbeatAt DateTime? @map("heartbeat_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  undoneAt    DateTime? @map("undone_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor        AppUser       @relation("ProductImportActor", fields: [createdBy], references: [id])
  catalogTasks CatalogTask[]

  @@index([tenantId, createdAt])
  @@index([status, heartbeatAt])
  @@map("product_import")
}

/// Whether a product is part of what this pharmacy actually sells.
///
/// REFERENCE — a lookup-only record (the NMRA registry). Findable in Search Catalog so a
/// pharmacist can look up any registered medicine in Sri Lanka, but kept out of the shop's
/// own product list and out of transaction pickers.
/// RANGED — the pharmacy stocks/sells this. Set explicitly ("Add to my products") or
/// automatically the first time stock arrives against the product.
///
/// Deliberately separate from `isActive`: range status answers "do we sell this", `isActive`
/// answers "is this record enabled" (a RANGED + inactive product is a discontinued line).
enum ProductRangeStatus {
  REFERENCE
  RANGED
}

/// Client-supplied idempotency keys (e.g. `Idempotency-Key` header) to avoid duplicate money mutations.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  scope          String   @db.VarChar(64)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId, scope, idempotencyKey])
  @@index([tenantId, scope, resourceId])
  @@map("idempotency_record")
}

model Tenant {
  id                       String   @id @default(uuid()) @db.Uuid
  code                     String   @unique
  legalName                String   @map("legal_name")
  displayName              String   @map("display_name")
  complianceRegion         String   @map("compliance_region")
  timezone                 String   @default("Asia/Colombo")
  isActive                 Boolean  @default(true) @map("is_active")
  /// Tenant-configured gross margin % goal shown on Reports → Profitability → Gross Profit's
  /// goal tracker. Null until an owner/manager sets one in Settings — never defaulted/fabricated.
  targetGrossMarginPercent Decimal? @map("target_gross_margin_percent") @db.Decimal(5, 2)
  /// Operating defaults shown in Settings → General → Tenant Profile, apply across every branch.
  currency                 String   @default("LKR")
  dateFormat               String   @default("DD/MM/YYYY") @map("date_format")
  fiscalYearStartMonth     Int      @default(1) @map("fiscal_year_start_month")
  businessRegistrationNo   String?  @map("business_registration_no")
  logoUrl                  String?  @map("logo_url")
  addressLine1             String?  @map("address_line1")
  addressLine2             String?  @map("address_line2")
  city                     String?
  postalCode               String?  @map("postal_code")
  email                    String?
  phone                    String?
  taxIdentificationNo      String?  @map("tax_identification_no")
  vatRegistrationNo        String?  @map("vat_registration_no")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  branches                Branch[]
  memberships             TenantMembership[]
  staffInvitations        StaffInvitation[]
  invitationRoles         StaffInvitationBranchRole[]
  users                   AppUser[]
  userBranchRoles         UserBranchRole[]
  auditEvents             AuditEvent[]
  suppliers               Supplier[]
  supplierInvoices        SupplierInvoice[]
  customers               Customer[]
  roles                   Role[]
  settings                TenantSettings?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  dashboardLayouts        DashboardLayout[]
  productImports          ProductImport[]

  @@map("tenant")
}

model Branch {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  code                    String
  name                    String
  timezone                String
  addressLine1            String?   @map("address_line1")
  addressLine2            String?   @map("address_line2")
  city                    String?
  district                String?
  postalCode              String?   @map("postal_code")
  phone                   String?
  email                   String?
  pharmacyLicenceNo       String?   @map("pharmacy_licence_no")
  pharmacyLicenceExpiry   DateTime? @map("pharmacy_licence_expiry") @db.Date
  responsiblePharmacist   String?   @map("responsible_pharmacist")
  pharmacistSlmcNo        String?   @map("pharmacist_slmc_no")
  openingHours            String?   @map("opening_hours")
  isActive                Boolean   @default(true) @map("is_active")
  /// First-run readiness is enabled only for branches created by the guided
  /// owner onboarding flow. Existing branches keep normal POS behaviour.
  setupRequired           Boolean   @default(false) @map("setup_required")
  setupMode               String    @default("fresh") @map("setup_mode")
  salesSettingsReviewedAt DateTime? @map("sales_settings_reviewed_at")
  /// When someone confirmed the opening stock figures match the shelves. Posting stock is a
  /// fact; agreeing it is correct is a decision, and only the second one means the branch is
  /// ready to sell from it — an import of 1,400 units shouldn't tick this off by itself.
  openingStockConfirmedAt DateTime? @map("opening_stock_confirmed_at")
  checkoutPreparedAt      DateTime? @map("checkout_prepared_at")
  setupCompletedAt        DateTime? @map("setup_completed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  tenant            Tenant                      @relation(fields: [tenantId], references: [id])
  userBranchRoles   UserBranchRole[]
  invitationRoles   StaffInvitationBranchRole[]
  batches           Batch[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  sales             Sale[]
  ledgerEntries     StockLedger[]
  transfersFrom     Transfer[]                  @relation("TransferFromBranch")
  transfersTo       Transfer[]                  @relation("TransferToBranch")
  goodsReturns      GoodsReturn[]
  stocktakes        Stocktake[]
  documentSequences DocumentSequence[]
  supplierInvoices  SupplierInvoice[]
  auditEvents       AuditEvent[]
  prescriptions     Prescription[]
  heldSales         HeldSale[]
  monthlyTargets    BranchMonthlyTarget[]
  notifications     Notification[]
  productImports    ProductImport[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branch")
}

/// Owner-set monthly sales target for a branch; optional manager accountable for achievement.
model BranchMonthlyTarget {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  /// Calendar month key, e.g. "2026-08" (Asia/Colombo month).
  yearMonth     String   @map("year_month") @db.VarChar(7)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(14, 2)
  managerUserId String?  @map("manager_user_id") @db.Uuid
  notes         String?  @db.VarChar(256)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  manager AppUser? @relation("BranchTargetManager", fields: [managerUserId], references: [id])
  creator AppUser? @relation("BranchTargetCreator", fields: [createdBy], references: [id])

  @@unique([tenantId, branchId, yearMonth])
  @@index([tenantId, yearMonth])
  @@index([tenantId, managerUserId])
  @@map("branch_monthly_target")
}

/// Tenant-wide feature defaults and policy toggles surfaced across Settings → Modules /
/// Alerts & Approvals / Security & Access. One row per tenant, lazily created on first
/// read/write via upsert (see TenantSettingsService) — every column has a sensible default
/// so a tenant with no row yet still resolves to sane behavior.
model TenantSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // ── Dashboard widgets (Settings → Modules → Main) ──
  showSalesTodayWidget        Boolean @default(true) @map("show_sales_today_widget")
  showLowStockWidget          Boolean @default(true) @map("show_low_stock_widget")
  showExpiringBatchesWidget   Boolean @default(true) @map("show_expiring_batches_widget")
  showTopProductsWidget       Boolean @default(true) @map("show_top_products_widget")
  showRecentActivityWidget    Boolean @default(false) @map("show_recent_activity_widget")
  showBranchPerformanceWidget Boolean @default(true) @map("show_branch_performance_widget")

  // ── POS / checkout defaults (Settings → Modules → Main) ──
  posQuickAddEnabled      Boolean @default(true) @map("pos_quick_add_enabled")
  posHeldSalesEnabled     Boolean @default(true) @map("pos_held_sales_enabled")
  posRequireCustomer      Boolean @default(false) @map("pos_require_customer")
  posAutoPrintReceipt     Boolean @default(true) @map("pos_auto_print_receipt")
  posDefaultPaymentMethod String  @default("cash") @map("pos_default_payment_method")
  posMaxDiscountPercent   Decimal @default(10) @map("pos_max_discount_percent") @db.Decimal(5, 2)

  // ── Receipt & invoice customization (Settings → Modules → Main) ──
  receiptPaperSize         String  @default("80mm") @map("receipt_paper_size")
  receiptCopies            Int     @default(1) @map("receipt_copies")
  receiptHeaderText        String? @map("receipt_header_text")
  receiptFooterText        String? @map("receipt_footer_text")
  receiptShowLogo          Boolean @default(true) @map("receipt_show_logo")
  receiptShowVatBreakdown  Boolean @default(true) @map("receipt_show_vat_breakdown")
  receiptShowStaffName     Boolean @default(true) @map("receipt_show_staff_name")
  receiptShowLoyaltyPoints Boolean @default(false) @map("receipt_show_loyalty_points")

  // ── Product display (Settings → Modules → Catalog) ──
  defaultProductView         String  @default("grid") @map("default_product_view")
  showControlledBadgeInLists Boolean @default(true) @map("show_controlled_badge_in_lists")

  // ── Tax configuration (Settings → Modules → Catalog) ──
  /// Overrides PRICING_VAT_RATE_PERCENT when set; env var stays the fallback when null.
  vatRatePercent              Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatCalculationMethod        String   @default("exclusive") @map("vat_calculation_method")
  prescriptionTaxExempt       Boolean  @default(true) @map("prescription_tax_exempt")
  showTaxBreakdownOnDocuments Boolean  @default(true) @map("show_tax_breakdown_on_documents")

  // ── Inventory & stock policies (Settings → Modules → Operations) ──
  lowStockThresholdUnits           Int     @default(20) @map("low_stock_threshold_units")
  expiryWarningDays                Int     @default(30) @map("expiry_warning_days")
  defaultStockView                 String  @default("batch") @map("default_stock_view")
  stockPickingMethod               String  @default("fefo") @map("stock_picking_method")
  barcodeAdjustmentsEnabled        Boolean @default(true) @map("barcode_adjustments_enabled")
  blockExpiredBatchSalesAtPos      Boolean @default(true) @map("block_expired_batch_sales_at_pos")
  requireBatchExpiryOnGoodsReceipt Boolean @default(true) @map("require_batch_expiry_on_goods_receipt")
  allowNegativeStock               Boolean @default(false) @map("allow_negative_stock")

  // ── Purchasing defaults (Settings → Modules → Operations) ──
  poNumberPrefix                  String  @default("PO-") @map("po_number_prefix")
  defaultSupplierPaymentTermsDays Int     @default(30) @map("default_supplier_payment_terms_days")
  autoReceiveOnInvoiceMatch       Boolean @default(false) @map("auto_receive_on_invoice_match")

  // ── Transfers & returns defaults (Settings → Modules → Operations) ──
  defaultReturnWindowDays   Int     @default(14) @map("default_return_window_days")
  requireTransferReasonNote Boolean @default(true) @map("require_transfer_reason_note")

  // ── Stocktake defaults (Settings → Modules → Operations) ──
  stocktakeDefaultCountMethod       String  @default("full") @map("stocktake_default_count_method")
  stocktakeVarianceTolerancePercent Decimal @default(2) @map("stocktake_variance_tolerance_percent") @db.Decimal(5, 2)

  // ── Alerts: recipients & channels ──
  alertEmailDigestEnabled   Boolean @default(true) @map("alert_email_digest_enabled")
  alertNotifyOwner          Boolean @default(true) @map("alert_notify_owner")
  alertNotifyManager        Boolean @default(true) @map("alert_notify_manager")
  alertNotifyPharmacist     Boolean @default(false) @map("alert_notify_pharmacist")
  alertNotifyInventoryClerk Boolean @default(true) @map("alert_notify_inventory_clerk")

  // ── Approval rules ──
  approvalRequiredPurchaseOrderThreshold Decimal? @map("approval_required_po_threshold") @db.Decimal(14, 2)
  approvalRequiredForBranchTransfers     Boolean  @default(true) @map("approval_required_for_branch_transfers")
  approvalRequiredReturnThreshold        Decimal? @map("approval_required_return_threshold") @db.Decimal(14, 2)
  /// Role keys (`Role.key`: a built-in RoleName or a custom role's slug) whose holders may approve
  /// a request they raised themselves. Everyone else needs a second person with the approve
  /// permission. Owners and managers by default: a small pharmacy's senior staff shouldn't be
  /// blocked, while a clerk's own stock write-off or transfer still gets a second pair of eyes.
  selfApprovalRoleKeys                   String[] @default(["owner", "manager"]) @map("self_approval_role_keys")

  // ── Insights & reports ──
  defaultReportPeriod       String  @default("this_month") @map("default_report_period")
  showFootfallAnalytics     Boolean @default(true) @map("show_footfall_analytics")
  weeklySummaryEmailEnabled Boolean @default(false) @map("weekly_summary_email_enabled")

  // ── Security policy ──
  sessionTimeoutMinutes         Int     @default(30) @map("session_timeout_minutes")
  auditLogRetentionDays         Int     @default(365) @map("audit_log_retention_days")
  passwordMinLength             Int     @default(8) @map("password_min_length")
  passwordRequireNumberOrSymbol Boolean @default(true) @map("password_require_number_or_symbol")
  passwordExpiryDays            Int     @default(0) @map("password_expiry_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model AppUser {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// Most recently selected membership. `tenantId` remains the legacy/home tenant.
  lastTenantId         String?   @map("last_tenant_id") @db.Uuid
  /// Globally unique — login resolves tenant from this email alone (subdomains may refine UX later).
  email                String    @unique
  fullName             String    @map("full_name")
  phone                String?   @map("phone")
  avatarUrl            String?   @map("avatar_url")
  passwordHash         String    @map("password_hash")
  /// Optional short till PIN (bcrypt). Used for pharmacist co-sign at POS without switching sessions.
  posPinHash           String?   @map("pos_pin_hash")
  failedPosPinAttempts Int       @default(0) @map("failed_pos_pin_attempts")
  posPinLockedUntil    DateTime? @map("pos_pin_locked_until")
  /// Bumped on logout-all, password change, role change, or detected refresh-reuse.
  /// Embedded in every access JWT; mismatch ⇒ 401.
  tokenVersion         Int       @default(0) @map("token_version")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  userBranchRoles         UserBranchRole[]
  sessions                Session[]
  purchaseOrdersCreated   PurchaseOrder[]          @relation("PurchaseOrderCreator")
  goodsReceiptsReceived   GoodsReceipt[]           @relation("GoodsReceiptReceiver")
  sales                   Sale[]                   @relation("SaleSeller")
  salesDispensed          Sale[]                   @relation("SaleDispenser")
  ledgerEntriesCreated    StockLedger[]            @relation("StockLedgerActor")
  transfersRequested      Transfer[]               @relation("TransferRequester")
  transfersApproved       Transfer[]               @relation("TransferApprover")
  transfersReceived       Transfer[]               @relation("TransferReceiver")
  goodsReturnsRequested   GoodsReturn[]            @relation("GoodsReturnRequester")
  goodsReturnsApproved    GoodsReturn[]            @relation("GoodsReturnApprover")
  goodsReturnsProcessed   GoodsReturn[]            @relation("GoodsReturnProcessor")
  stocktakesCounted       Stocktake[]              @relation("StocktakeCounter")
  stocktakesAssigned      StocktakeAssignment[]
  branchTargetsManaged    BranchMonthlyTarget[]    @relation("BranchTargetManager")
  branchTargetsCreated    BranchMonthlyTarget[]    @relation("BranchTargetCreator")
  stocktakesReviewed      Stocktake[]              @relation("StocktakeReviewer")
  stocktakesApproved      Stocktake[]              @relation("StocktakeApprover")
  stocktakesPosted        Stocktake[]              @relation("StocktakePoster")
  stocktakesCompleted     Stocktake[]              @relation("StocktakeCompleter")
  stocktakeCountEntries   StocktakeCountEntry[]
  stocktakePostings       StocktakePosting[]
  productImports          ProductImport[]          @relation("ProductImportActor")
  stocktakeLineReviews    StocktakeLine[]          @relation("StocktakeLineReviewer")
  stocktakeLineApprovals  StocktakeLine[]          @relation("StocktakeLineApprover")
  stocktakePostingLines   StocktakePostingLine[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  prescriptionsCreated    Prescription[]           @relation("PrescriptionCreator")
  heldSales               HeldSale[]               @relation("HeldSaleHolder")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  dashboardLayouts        DashboardLayout[]
  tenantMemberships       TenantMembership[]
  invitationsSent         StaffInvitation[]        @relation("StaffInvitationInviter")
  invitationsAccepted     StaffInvitation[]        @relation("StaffInvitationAcceptor")
  nmraLinksCreated        ProductNmraLink[]        @relation("ProductNmraLinkActor")
  catalogTasksResolved    CatalogTask[]            @relation("CatalogTaskResolver")
  passwordResetTokens     PasswordResetToken[]

  @@index([tenantId])
  @@map("app_user")
}

/**
 * Self-service password recovery. Deliberately NOT tenant-scoped: `AppUser.email`
 * is globally unique and a person requesting a reset is unauthenticated, so there
 * is no branch header or tenant context to scope by — the token itself is the
 * only credential, exactly like `StaffInvitation`.
 * Only the SHA-256 hash of the token is stored; the raw value exists solely in
 * the email that was sent. A row is single-use (`usedAt`) and short-lived, and
 * requesting a new reset invalidates any outstanding ones for that user.
 */
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// Captured for the audit trail — a reset is a security-sensitive event.
  requestIp String?   @map("request_ip")
  createdAt DateTime  @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/**
 * A user's membership in one pharmacy business. AppUser remains the global
 * sign-in identity during this migration phase; this row is the authoritative
 * tenant access boundary and allows the same person to join multiple tenants.
 */
model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@map("tenant_membership")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  branchId        String?              @map("branch_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  category        NotificationCategory
  severity        NotificationSeverity @default(info)
  title           String               @db.VarChar(180)
  message         String?              @db.VarChar(600)
  actionLabel     String?              @map("action_label") @db.VarChar(80)
  actionHref      String?              @map("action_href") @db.VarChar(500)
  entityType      String?              @map("entity_type") @db.VarChar(80)
  entityId        String?              @map("entity_id") @db.Uuid
  dedupeKey       String               @map("dedupe_key") @db.VarChar(240)
  source          String               @default("domain_event") @db.VarChar(80)
  metadata        Json?
  requiresAction  Boolean              @default(false) @map("requires_action")
  readAt          DateTime?            @map("read_at")
  archivedAt      DateTime?            @map("archived_at")
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipient AppUser @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, recipientUserId, dedupeKey])
  @@index([tenantId, recipientUserId, archivedAt, resolvedAt, createdAt(sort: Desc)])
  @@index([tenantId, recipientUserId, readAt])
  @@index([tenantId, branchId, category])
  @@map("notification")
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  inventoryEnabled  Boolean  @default(true) @map("inventory_enabled")
  expiryEnabled     Boolean  @default(true) @map("expiry_enabled")
  purchasingEnabled Boolean  @default(true) @map("purchasing_enabled")
  transfersEnabled  Boolean  @default(true) @map("transfers_enabled")
  stocktakesEnabled Boolean  @default(true) @map("stocktakes_enabled")
  salesEnabled      Boolean  @default(true) @map("sales_enabled")
  complianceEnabled Boolean  @default(true) @map("compliance_enabled")
  systemEnabled     Boolean  @default(true) @map("system_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("notification_preference")
