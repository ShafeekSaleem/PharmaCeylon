model StockLedger {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  batchId       String?           @map("batch_id") @db.Uuid
  movementType  StockMovementType @map("movement_type")
  qtyDelta      Int               @map("qty_delta")
  bucket        StockBucket       @default(sellable)
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id") @db.Uuid
  reason        String?           @db.VarChar(512)
  /// Machine-readable reason for exceptional movements (quarantine, write-off), alongside the
  /// free-text `reason` a person typed. See `inventory/stock/stock-reasons.ts`.
  reasonCode    String?           @map("reason_code") @db.VarChar(32)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  branch  Branch   @relation(fields: [branchId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])
  actor   AppUser? @relation("StockLedgerActor", fields: [createdBy], references: [id])

  @@index([tenantId, branchId, productId, occurredAt(sort: Desc)])
  @@index([tenantId, branchId, batchId])
  @@index([tenantId, branchId, occurredAt(sort: Desc)])
  @@index([tenantId, referenceType, referenceId])
  @@map("stock_ledger")
}

/// Running quantities for one batch, kept by `StockService` in the same transaction as every
/// ledger write. The ledger stays the permanent record and this is a projection of it: summing
/// the whole ledger on every stock check was both slow and, with no lock, unsafe under
/// concurrent sales. `scripts/reconcile-stock.mjs` proves the two still agree.
model BatchStock {
  batchId        String   @id @map("batch_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  /// Physically at the branch: sellable plus quarantined. Sum of every ledger row for the batch.
  onHandQty      Int      @default(0) @map("on_hand_qty")
  /// Held back from sale and transfer. Sum of the batch's `quarantine` bucket rows.
  quarantinedQty Int      @default(0) @map("quarantined_qty")
  /// Set aside for approved documents (transfers). Sum of active `StockReservation` rows.
  reservedQty    Int      @default(0) @map("reserved_qty")
  updatedAt      DateTime @updatedAt @map("updated_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, productId])
  @@map("batch_stock")
}

/// Stock promised to a document that has not moved yet — an approved transfer waiting to ship.
/// Reserved units are still on hand, so they are counted by a stocktake and valued in stock,
/// but they are no longer available to sell or promise twice.
model StockReservation {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  branchId     String                 @map("branch_id") @db.Uuid
  productId    String                 @map("product_id") @db.Uuid
  batchId      String                 @map("batch_id") @db.Uuid
  qty          Int
  sourceType   String                 @map("source_type") @db.VarChar(32)
  sourceId     String                 @map("source_id") @db.Uuid
  sourceLineId String?                @map("source_line_id") @db.Uuid
  status       StockReservationStatus @default(active)
  createdBy    String?                @map("created_by") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")
  releasedAt   DateTime?              @map("released_at")
  consumedAt   DateTime?              @map("consumed_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, batchId, status])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_reservation")
}

model Transfer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  fromBranchId   String         @map("from_branch_id") @db.Uuid
  toBranchId     String         @map("to_branch_id") @db.Uuid
  transferNumber String         @map("transfer_number")
  status         TransferStatus @default(requested)
  notes          String?
  expectedOn     DateTime?      @map("expected_on") @db.Date
  requestedBy    String         @map("requested_by") @db.Uuid
  approvedBy     String?        @map("approved_by") @db.Uuid
  receivedBy     String?        @map("received_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  fromBranch Branch   @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch   @relation("TransferToBranch", fields: [toBranchId], references: [id])
  requester  AppUser  @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver   AppUser? @relation("TransferApprover", fields: [approvedBy], references: [id])
  receiver   AppUser? @relation("TransferReceiver", fields: [receivedBy], references: [id])

  items TransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, fromBranchId, status])
  @@index([tenantId, toBranchId, status])
  @@map("transfer")
}

model TransferItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  transferId  String  @map("transfer_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid
  qty         Int
  receivedQty Int     @default(0) @map("received_qty")

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@map("transfer_item")
}

model GoodsReturn {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  returnNumber    String            @map("return_number")
  type            GoodsReturnType
  status          GoodsReturnStatus @default(draft)
  customerName    String?           @map("customer_name")
  saleId          String?           @map("sale_id") @db.Uuid
  supplierId      String?           @map("supplier_id") @db.Uuid
  purchaseOrderId String?           @map("purchase_order_id") @db.Uuid
  goodsReceiptId  String?           @map("goods_receipt_id") @db.Uuid
  reason          String?
  notes           String?
  amount          Decimal           @default(0) @db.Decimal(12, 2)
  requestedBy     String            @map("requested_by") @db.Uuid
  approvedBy      String?           @map("approved_by") @db.Uuid
  processedBy     String?           @map("processed_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  branch        Branch         @relation(fields: [branchId], references: [id])
  sale          Sale?          @relation(fields: [saleId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  requester     AppUser        @relation("GoodsReturnRequester", fields: [requestedBy], references: [id])
  approver      AppUser?       @relation("GoodsReturnApprover", fields: [approvedBy], references: [id])
  processor     AppUser?       @relation("GoodsReturnProcessor", fields: [processedBy], references: [id])

  items GoodsReturnItem[]

  @@unique([tenantId, branchId, returnNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@map("goods_return")
}

model GoodsReturnItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  returnId  String  @map("return_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  batchId   String? @map("batch_id") @db.Uuid
  qty       Int
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)

  goodsReturn GoodsReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  batch       Batch?      @relation(fields: [batchId], references: [id])

  @@map("goods_return_item")
}

model Stocktake {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  branchId             String                @map("branch_id") @db.Uuid
  stocktakeNumber      String                @map("stocktake_number")
  status               StocktakeStatus       @default(draft)
  scope                StocktakeScope        @default(full)
  movementMode         StocktakeMovementMode @default(continue_and_reconcile) @map("movement_mode")
  /// When true, counters do not see system qty until supervisor review.
  blindCount           Boolean               @default(false) @map("blind_count")
  /// Legacy mutable snapshot time retained for backfill compatibility.
  frozenAt             DateTime?             @map("frozen_at")
  /// Immutable baseline snapshot time used for reconciliation.
  snapshotAt           DateTime?             @map("snapshot_at")
  scheduledFor         DateTime?             @map("scheduled_for")
  expectedCompletionAt DateTime?             @map("expected_completion_at")
  nearExpiryDays       Int?                  @map("near_expiry_days")
  title                String?               @db.VarChar(160)
  areaLabel            String?               @map("area_label") @db.VarChar(160)
  notes                String?
  countedBy            String                @map("counted_by") @db.Uuid
  reviewerId           String?               @map("reviewer_id") @db.Uuid
  approvedBy           String?               @map("approved_by") @db.Uuid
  postedBy             String?               @map("posted_by") @db.Uuid
  completedBy          String?               @map("completed_by") @db.Uuid
  startedAt            DateTime?             @map("started_at")
  submittedAt          DateTime?             @map("submitted_at")
  reviewStartedAt      DateTime?             @map("review_started_at")
  approvedAt           DateTime?             @map("approved_at")
  postedAt             DateTime?             @map("posted_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  branch        Branch                  @relation(fields: [branchId], references: [id])
  counter       AppUser                 @relation("StocktakeCounter", fields: [countedBy], references: [id])
  reviewer      AppUser?                @relation("StocktakeReviewer", fields: [reviewerId], references: [id])
  approver      AppUser?                @relation("StocktakeApprover", fields: [approvedBy], references: [id])
  poster        AppUser?                @relation("StocktakePoster", fields: [postedBy], references: [id])
  completer     AppUser?                @relation("StocktakeCompleter", fields: [completedBy], references: [id])
  lines         StocktakeLine[]
  assignments   StocktakeAssignment[]
  snapshotLines StocktakeSnapshotLine[]
  countEntries  StocktakeCountEntry[]
  postings      StocktakePosting[]

  @@unique([tenantId, branchId, stocktakeNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, scheduledFor])
  @@map("stocktake")
}

model StocktakeLine {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  stocktakeId      String                   @map("stocktake_id") @db.Uuid
  productId        String                   @map("product_id") @db.Uuid
  batchId          String                   @map("batch_id") @db.Uuid
  systemQty        Int                      @map("system_qty")
  countedQty       Int?                     @map("counted_qty")
  varianceQty      Int?                     @map("variance_qty")
  status           StocktakeCountStatus     @default(pending)
  condition        StocktakeCondition       @default(saleable)
  note             String?                  @db.VarChar(512)
  reviewReason     StocktakeVarianceReason? @map("review_reason")
  reviewResolution String?                  @map("review_resolution") @db.VarChar(512)
  reviewNote       String?                  @map("review_note") @db.VarChar(512)
  reviewedBy       String?                  @map("reviewed_by") @db.Uuid
  approvedBy       String?                  @map("approved_by") @db.Uuid
  countedAt        DateTime?                @map("counted_at")
  reviewedAt       DateTime?                @map("reviewed_at")
  approvedAt       DateTime?                @map("approved_at")
  postedAt         DateTime?                @map("posted_at")

  stocktake    Stocktake              @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id])
  batch        Batch                  @relation(fields: [batchId], references: [id])
  reviewer     AppUser?               @relation("StocktakeLineReviewer", fields: [reviewedBy], references: [id])
  approver     AppUser?               @relation("StocktakeLineApprover", fields: [approvedBy], references: [id])
  countEntries StocktakeCountEntry[]
  snapshotLine StocktakeSnapshotLine?
  postingLines StocktakePostingLine[]

  @@unique([stocktakeId, batchId])
  @@index([tenantId, stocktakeId, status])
  @@map("stocktake_line")
}

model StocktakeAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  areaLabel   String?  @map("area_label") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  user      AppUser   @relation(fields: [userId], references: [id])

  @@unique([stocktakeId, userId])
  @@index([tenantId, userId])
  @@map("stocktake_assignment")
}

model StocktakeSnapshotLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  lineId      String   @unique @map("line_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  snapshotQty Int      @map("snapshot_qty")
  createdAt   DateTime @default(now()) @map("created_at")

  stocktake Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  line      StocktakeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])
  batch     Batch         @relation(fields: [batchId], references: [id])

  @@unique([stocktakeId, batchId])
  @@index([tenantId, stocktakeId])
  @@map("stocktake_snapshot_line")
}

model StocktakeCountEntry {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  stocktakeId String             @map("stocktake_id") @db.Uuid
  lineId      String             @map("line_id") @db.Uuid
  countedQty  Int                @map("counted_qty")
  condition   StocktakeCondition @default(saleable)
  note        String?            @db.VarChar(512)
  isRecount   Boolean            @default(false) @map("is_recount")
  countedBy   String             @map("counted_by") @db.Uuid
  countedAt   DateTime           @default(now()) @map("counted_at")

  stocktake Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  line      StocktakeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  counter   AppUser       @relation(fields: [countedBy], references: [id])

  @@index([tenantId, stocktakeId, lineId, countedAt(sort: Desc)])
  @@map("stocktake_count_entry")
}

model StocktakePosting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  postedBy    String   @map("posted_by") @db.Uuid
  postedAt    DateTime @default(now()) @map("posted_at")
  note        String?  @db.VarChar(512)

  stocktake Stocktake              @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  poster    AppUser                @relation(fields: [postedBy], references: [id])
  lines     StocktakePostingLine[]

  @@index([tenantId, stocktakeId])
  @@map("stocktake_posting")
}

model StocktakePostingLine {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  postingId         String            @map("posting_id") @db.Uuid
  lineId            String            @map("line_id") @db.Uuid
  qtyDelta          Int               @map("qty_delta")
  movementType      StockMovementType @map("movement_type")
  ledgerReferenceId String            @map("ledger_reference_id") @db.Uuid
  reason            String?           @db.VarChar(512)
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         String            @map("created_by") @db.Uuid

  posting StocktakePosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  line    StocktakeLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  actor   AppUser          @relation(fields: [createdBy], references: [id])

  @@index([tenantId, postingId])
  @@index([tenantId, lineId])
  @@map("stocktake_posting_line")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventName   String   @map("event_name")
  entityName  String   @map("entity_name")
  entityId    String   @map("entity_id") @db.Uuid
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  branch Branch?  @relation(fields: [branchId], references: [id])
  actor  AppUser? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([tenantId, entityName, entityId, createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_event")
}

model OwnerRegistration {
  id                       String                  @id @default(uuid()) @db.Uuid
  email                    String                  @unique
  firstName                String                  @map("first_name")
  lastName                 String                  @map("last_name")
  phone                    String?
  passwordHash             String                  @map("password_hash")
  status                   OwnerRegistrationStatus @default(pending_email)
  verificationTokenHash    String?                 @unique @map("verification_token_hash")
  verificationExpiresAt    DateTime?               @map("verification_expires_at")
  verifiedAt               DateTime?               @map("verified_at")
  onboardingSessionVersion Int                     @default(0) @map("onboarding_session_version")
  onboardingDraft          Json?                   @map("onboarding_draft")
  completedTenantId        String?                 @map("completed_tenant_id") @db.Uuid
  completedUserId          String?                 @map("completed_user_id") @db.Uuid
  completedAt              DateTime?               @map("completed_at")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([status, verificationExpiresAt])
  @@map("owner_registration")
}
