/// One persisted dashboard-canvas layout per user (widget positions/sizes).
/// A missing row just means the user hasn't customized yet — the frontend
/// falls back to the role's default layout in that case.
model DashboardLayout {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  widgets   Json     @map("widgets")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("dashboard_layout")
}

/// Refresh-token-backed session. One row per issued refresh token.
/// Rotation: on refresh we create a new row sharing `familyId`, mark the old
/// row revoked with `replacedById` pointing at the new one. Reuse of a revoked
/// row triggers revocation of every row in the family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid

  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  role      RoleName
  /**
   * FK to the tenant-scoped Role row driving permission resolution.
   * For built-in roles this points at that tenant's seeded system Role
   * (kept in sync with `role`); for `role: custom` it points at the
   * tenant's custom Role. `role` itself stays authoritative for the
   * hardcoded owner-bypass safety check in the guard — never removed.
   */
  roleId    String?  @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    AppUser @relation(fields: [userId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  roleRef Role?   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, branchId, role])
  @@map("user_branch_role")
}

model StaffInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String
  fullName        String    @map("full_name")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  acceptedUserId  String?   @map("accepted_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy  AppUser                     @relation("StaffInvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy AppUser?                    @relation("StaffInvitationAcceptor", fields: [acceptedUserId], references: [id])
  roles      StaffInvitationBranchRole[]

  @@index([tenantId, email, acceptedAt, revokedAt])
  @@index([expiresAt])
  @@map("staff_invitation")
}

model StaffInvitationBranchRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  invitationId String   @map("invitation_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  role         RoleName
  roleId       String?  @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roleRef    Role?           @relation(fields: [roleId], references: [id])

  @@unique([invitationId, branchId, role])
  @@index([tenantId, branchId])
  @@map("staff_invitation_branch_role")
}

model Permission {
  /**
   * Global catalog — not tenant-scoped. Seeded from `security/permission-catalog.ts`.
   */
  key         String   @id
  module      String
  label       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /**
   * Stable slug: matches the RoleName enum value for built-ins, or a generated slug for custom roles.
   */
  key         String
  name        String
  description String?
  /**
   * True for the 6 seeded built-in roles; false for tenant-created custom roles.
   */
  isSystem    Boolean  @default(false) @map("is_system")
  /**
   * True only for the "owner" role row. Permissions on a locked role can't
   * be edited and the role can't be deleted/renamed — prevents a tenant
   * from ever locking out all owners.
   */
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant                      @relation(fields: [tenantId], references: [id])
  permissions     RolePermission[]
  userBranchRoles UserBranchRole[]
  invitationRoles StaffInvitationBranchRole[]

  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([roleId, permissionKey])
  @@map("role_permission")
}

model Supplier {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  code             String
  name             String
  type             SupplierType   @default(distributor)
  status           SupplierStatus @default(active)
  phone            String?
  email            String?
  contactName      String?        @map("contact_name")
  leadTimeDays     Int            @default(2) @map("lead_time_days")
  paymentTermsDays Int            @default(30) @map("payment_terms_days")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReturns   GoodsReturn[]
  invoices       SupplierInvoice[]
  batches        Batch[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("supplier")
}

model SupplierInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  supplierId     String                @map("supplier_id") @db.Uuid
  branchId       String?               @map("branch_id") @db.Uuid
  invoiceNumber  String                @map("invoice_number")
  goodsReceiptId String?               @unique @map("goods_receipt_id") @db.Uuid
  invoiceDate    DateTime              @map("invoice_date") @db.Date
  dueDate        DateTime              @map("due_date") @db.Date
  totalAmount    Decimal               @map("total_amount") @db.Decimal(14, 2)
  paidAmount     Decimal               @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status         SupplierInvoiceStatus @default(open)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("supplier_invoice")
}

model Product {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  sku                   String
  barcode               String?
  name                  String
  brandName             String?            @map("brand_name")
  genericName           String?            @map("generic_name")
  manufacturer          String?
  dosageForm            String?            @map("dosage_form")
  strength              String?
  unit                  String?
  packSize              String?            @map("pack_size")
  /// NMRA pack type (blister, vial, bottle, etc.).
  packType              String?            @map("pack_type")
  storage               String?
  shelfLife             String?            @map("shelf_life")
  taxCategory           String?            @map("tax_category")
  imageUrl              String?            @map("image_url")
  /// NMRA registration number (REG.NO.).
  registrationNo        String?            @map("registration_no")
  registrationDate      DateTime?          @map("registration_date") @db.Date
  /// NMRA schedule classification (I, IIA, IIB, IIC, III, …).
  schedule              String?
  /// NMRA registration type (Full, Two Years, Provisional).
  regType               String?            @map("reg_type")
  dossierNo             String?            @map("dossier_no")
  countryOfOrigin       String?            @map("country_of_origin")
  /// Local marketing authorisation holder / agent in Sri Lanka.
  localAgent            String?            @map("local_agent")
  /// Schedule / narcotic-class — needs pharmacist dispense authority (PIN or elevated session).
  isControlled          Boolean            @default(false) @map("is_controlled")
  /// Needs a linked prescription to sell (antibiotics etc.). Controlled always implies this.
  requiresPrescription  Boolean            @default(false) @map("requires_prescription")
  reorderLevel          Int                @default(0) @map("reorder_level")
  /// Pharmacist-owned "is this record enabled". Imports must never write this — an NMRA
  /// refresh that flips it would silently undo a pharmacy's own deactivations.
  isActive              Boolean            @default(true) @map("is_active")
  /// Does this pharmacy sell it? Defaults to RANGED so manually created products are part of
  /// the range immediately; the NMRA importer explicitly writes REFERENCE on create.
  rangeStatus           ProductRangeStatus @default(RANGED) @map("range_status")
  /// When the product entered the pharmacy's own range. Null while REFERENCE.
  rangedAt              DateTime?          @map("ranged_at")
  /// Is the NMRA registration current? Import-owned, only meaningful when source = NMRA.
  /// This is the meaning the importer used to write onto `isActive`.
  nmraRegistrationValid Boolean?           @map("nmra_registration_valid")
  /// Catalog record origin. NMRA-specific fields are only expected when source = NMRA —
  /// MANUAL/SUPPLIER/CSV_IMPORT/BARCODE retail products may leave them null.
  source                CatalogSource      @default(MANUAL)
  /// The ProductImport run that created this row, so a mistaken 2,000-row import can be undone
  /// while nothing has been sold against it. Plain column rather than a relation, matching
  /// StockLedger.referenceId — it is a provenance stamp, not a dependency.
  importId              String?            @map("import_id") @db.Uuid
  /// The REFERENCE (registry) product this one has been linked to, absorbing its registration
  /// number, schedule and compliance flags. Unique per tenant — a register row can be claimed
  /// by at most one shop product. Self-relation rather than a lookup on `ProductNmraLink` so
  /// Search Catalog can hide a claimed reference row with a plain `claimedBy: null` filter.
  nmraReferenceId       String?            @unique @map("nmra_reference_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  batches                Batch[]
  purchaseItems          PurchaseOrderItem[]
  receiptItems           GoodsReceiptItem[]
  saleItems              SaleItem[]
  ledgerEntries          StockLedger[]
  transferItems          TransferItem[]
  returnItems            GoodsReturnItem[]
  stocktakeLines         StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]
  tagMaps                ProductTagMap[]
  aliases                ProductAlias[]
  categoryMaps           ProductCategoryMap[]
  similarities           ProductSimilarity[]     @relation("ProductSimilarityProduct")
  similarTo              ProductSimilarity[]     @relation("ProductSimilaritySimilar")
  /// The reference row this product claims, if any.
  nmraReference          Product?                @relation("ProductNmraReference", fields: [nmraReferenceId], references: [id], onDelete: SetNull)
  /// The shop product that has claimed this row, if this row is a claimed reference product.
  claimedBy              Product?                @relation("ProductNmraReference")
  nmraLink               ProductNmraLink?
  /// Register-link history rows pointing AT this product as the reference row. Exists so the
  /// FK below can restrict deletion instead of leaving orphaned link history.
  nmraLinksAsReference   ProductNmraLink[]       @relation("ProductNmraLinkReference")
  catalogTasks           CatalogTask[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@index([tenantId, brandName])
  @@index([tenantId, genericName])
  @@index([tenantId, importId])
  @@index([tenantId, name])
  @@index([tenantId, rangeStatus])
  @@index([tenantId, registrationNo])
  @@index([tenantId, schedule])
  @@index([tenantId, source])
  @@map("product")
}

/// Records a link between a shop's own product and an NMRA reference row it absorbed fields
/// from — the adopted field values and what they replaced, so unlinking is exact rather than a
/// best guess. One row per linked product (the reference row's id lives on `Product.nmraReferenceId`,
/// this table is the undo record, not the second copy of the pointer).
model ProductNmraLink {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  productId          String   @unique @map("product_id") @db.Uuid
  referenceProductId String   @map("reference_product_id") @db.Uuid
  /// Field keys actually changed by the link (for the audit trail and undo UI — not needed to
  /// perform the restore itself, `previousValues` already carries every value verbatim).
  adoptedFields      Json     @map("adopted_fields")
  /// Every value the link overwrote, plus the aliases/category maps/tags it added — enough to
  /// put the product back exactly as it was, compliance flags included.
  previousValues     Json     @map("previous_values")
  linkedByUserId     String?  @map("linked_by_user_id") @db.Uuid
  linkedAt           DateTime @default(now()) @map("linked_at")

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: this row is the undo record for a link, and losing it silently
  /// would strand a product carrying adopted registration data with no way back. Deleting a
  /// reference row that a product has linked to must unlink first — see
  /// `ProductNmraLinkService.unlink`.
  referenceProduct Product  @relation("ProductNmraLinkReference", fields: [referenceProductId], references: [id], onDelete: Restrict)
  linkedBy         AppUser? @relation("ProductNmraLinkActor", fields: [linkedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, referenceProductId])
  @@map("product_nmra_link")
}

/// One catalog decision waiting on a person, in a queue that survives restarts.
///
/// Before this existed the same work was recomputed on every page load of two separate
/// screens, which meant a decision could never be *made* — dismissing an umbrella from the
/// NMRA match list only hid it until the next refresh. A row here has a durable lifecycle, so
/// "this is not a medicine" and "I already looked, it's not a match" are answers that stick.
///
/// Generated by `CatalogTaskService.refresh`, which upserts OPEN/NEEDS_REVIEW rows and leaves
/// every terminal row (RESOLVED / DISMISSED / NOT_APPLICABLE) alone.
model CatalogTask {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  type      CatalogTaskType
  status    CatalogTaskStatus @default(OPEN)

  /// The resolution this task proposes, shaped per type: `{ categoryId, categoryName,
  /// categoryPath }` for MISSING_CATEGORY, `{ referenceProductId, name, brandName,
  /// registrationNo }` for NMRA_MATCH. Null when nothing could be suggested.
  suggestion Json?
  /// Why the suggestion was made, in the matcher's own vocabulary ("barcode", "registration",
  /// "name", "normalized", "fuzzy", "inn_head", "name_rule"). Shown to the user as evidence —
  /// a suggestion without a stated reason is not actionable.
  evidence   String?  @db.VarChar(32)
  confidence Decimal? @db.Decimal(4, 3)

  /// Applying this task would change `isControlled` or `requiresPrescription`. Excluded from
  /// bulk "apply safe changes" no matter how strong the evidence.
  complianceImpact Boolean @default(false) @map("compliance_impact")
  /// Meets every safe-apply condition (unique high-confidence match, no compliance change, no
  /// identifier ambiguity, no existing link). Precomputed at generation time so the bulk
  /// endpoint and the on-screen count can never disagree.
  safeToApply      Boolean @default(false) @map("safe_to_apply")

  /// For NMRA_AMBIGUOUS: every candidate the identifier resolved to, so the audit trail says
  /// which rows collided rather than just "ambiguous".
  candidates Json?

  /// Provenance: which import created the product this task is about, and which row of it.
  /// Lets the post-import screen deep-link straight to "the tasks this upload created".
  importId  String? @map("import_id") @db.Uuid
  sourceRow Int?    @map("source_row")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  /// Free-text reason captured when a task is dismissed or marked not applicable.
  resolutionNote   String?   @map("resolution_note")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy AppUser?       @relation("CatalogTaskResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  import     ProductImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  /// One task per product per type — `refresh` upserts on this, which is what makes
  /// regeneration idempotent and stops a nightly sweep re-opening dismissed work.
  @@unique([tenantId, productId, type])
  @@index([tenantId, status, type])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, importId])
  @@index([tenantId, status, safeToApply])
  @@map("catalog_task")
}

model ProductCategory {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  /// Which classification axis this category belongs to. COMMERCIAL is the only dimension
  /// tenants manage via Settings → Catalog → Categories; the others are import-derived.
  dimension        CategoryDimension @default(DOSAGE_FORM)
  name             String
  parentCategoryId String?           @map("parent_category_id") @db.Uuid
  /// Stable SaaS-level identity for predefined COMMERCIAL categories (e.g. "MEDICINES_PAIN_FEVER").
  /// Null for tenant-created custom categories and for non-COMMERCIAL dimension rows. Never used
  /// for display — display names may be renamed per tenant without breaking reporting/history.
  canonicalKey     String?           @map("canonical_key")
  source           CategorySource    @default(TENANT)
  /// True for the seeded commercial template and NMRA-import taxonomy roots/children — governs
  /// whether a tenant can rename/delete vs. only enable/disable.
  isSystem         Boolean           @default(false) @map("is_system")
  /// Whether this category is enabled for the tenant. Standard (isSystem) categories the tenant
  /// hasn't opted into stay inactive rather than being deleted, so they remain available to
  /// enable later. Disabling never cascades — historical ProductCategoryMap rows are preserved.
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  parent       ProductCategory?     @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children     ProductCategory[]    @relation("CategoryHierarchy")
  categoryMaps ProductCategoryMap[]

  @@unique([tenantId, dimension, name, parentCategoryId])
  @@unique([tenantId, canonicalKey])
  @@index([tenantId, dimension])
  @@index([tenantId, dimension, isActive])
  @@index([tenantId, parentCategoryId])
  @@index([tenantId, canonicalKey])
  @@map("product_category")
}

model ProductTag {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  /// True for the tags the NMRA importer derives and re-applies on every refresh. They can't
  /// be renamed or deleted: one click used to drop thousands of assignments the importer owns
  /// and would only partly rebuild.
  isSystem     Boolean  @default(false) @map("is_system")
  /// Stable identity for a system tag, so a display-name change never orphans it. Null for
  /// tenant-created tags.
  canonicalKey String?  @map("canonical_key")
  createdAt    DateTime @default(now()) @map("created_at")

  tagMaps ProductTagMap[]

  @@unique([tenantId, name])
  @@unique([tenantId, canonicalKey])
  @@index([tenantId, isSystem])
  @@map("product_tag")
}

model ProductTagMap {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, tagId])
  @@index([tenantId, productId])
  @@map("product_tag_map")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  aliasText String   @map("alias_text")
  aliasType String   @default("synonym") @map("alias_type")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, aliasText])
  @@index([tenantId, aliasText])
  @@map("product_alias")
}

model ProductSimilarity {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  similarProductId String   @map("similar_product_id") @db.Uuid
  score            Decimal  @db.Decimal(5, 4)
  reasonCode       String   @map("reason_code")
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product @relation("ProductSimilarityProduct", fields: [productId], references: [id], onDelete: Cascade)
  similarProduct Product @relation("ProductSimilaritySimilar", fields: [similarProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, similarProductId, reasonCode])
  @@map("product_similarity")
}

model ProductCategoryMap {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  productId        String                   @map("product_id") @db.Uuid
  categoryId       String                   @map("category_id") @db.Uuid
  /// Denormalized copy of `category.dimension`, set at write time by the service layer.
  /// Lets the DB enforce "at most one primary COMMERCIAL category per product" via a partial
  /// unique index (see migration SQL) without a join, and lets report queries filter by
  /// dimension without joining ProductCategory on every row.
  dimension        CategoryDimension
  /// For COMMERCIAL: the product's single primary merchandising category — all financial/
  /// profitability reporting groups by this so a product is never double counted. Secondary
  /// COMMERCIAL maps (isPrimary = false) are for discovery only. Always true for non-COMMERCIAL
  /// dimensions (Schedule/Form/RegType don't have a primary/secondary concept).
  isPrimary        Boolean                  @default(true) @map("is_primary")
  assignmentSource CategoryAssignmentSource @default(MANUAL) @map("assignment_source")
  /// AI-suggested-mapping confidence (0–1), only meaningful when assignmentSource = AUTO_CLASSIFIED.
  confidence       Decimal?                 @db.Decimal(4, 3)
  createdAt        DateTime                 @default(now()) @map("created_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, categoryId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
  @@index([tenantId, productId, dimension])
  @@map("product_category_map")
}

model DocumentSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  docType   String   @map("doc_type") @db.VarChar(32)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, docType])
  @@map("document_sequence")
}

model Batch {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  batchNo           String    @map("batch_no")
  expiryDate        DateTime  @map("expiry_date") @db.Date
  costPrice         Decimal   @map("cost_price") @db.Decimal(12, 2)
  sellingPrice      Decimal   @map("selling_price") @db.Decimal(12, 2)
  /// Derived by `StockService`: true when every unit on hand is in quarantine, i.e. the whole
  /// batch is held (a recall, an expired lot). Part of a batch can be quarantined without this
  /// flag — sale and transfer checks read `BatchStock` quantities, not this.
  isQuarantined     Boolean   @default(false) @map("is_quarantined")
  /// When units were last moved into quarantine, and why. Cleared once nothing is held.
  quarantinedAt     DateTime? @map("quarantined_at")
  quarantineReason  String?   @map("quarantine_reason") @db.VarChar(512)
  /// Direct supplier reference, set at batch-creation time (goods receipt: from the PO's
  /// supplier; manual stock adjustment: whoever entered it may tag one, since not every
  /// opening-stock/adjustment batch has a PO behind it). Nullable — supplier is genuinely
  /// unknown for some manually-entered batches. This is the authoritative lookup for "who
  /// supplied this batch"; `GoodsReceiptItem → GoodsReceipt → PurchaseOrder → Supplier` is a
  /// fallback for batches created before this column existed, not a replacement for it.
  supplierId        String?   @map("supplier_id") @db.Uuid
  /// True when this batch was imported without a real expiry date and carries a far-future
  /// placeholder instead. Old systems frequently don't export expiry, and rejecting those rows
  /// would make a migration import unusable — so the batch is accepted, kept out of expiry
  /// alerts (it would otherwise report a date nobody entered), and listed for review. The
  /// placeholder sorts last under FEFO, so a flagged batch is never picked ahead of a real one.
  needsExpiryReview Boolean   @default(false) @map("needs_expiry_review")
  receivedAt        DateTime  @default(now()) @map("received_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  receiptItems           GoodsReceiptItem[]
  saleItems              SaleItem[]
  ledgerEntries          StockLedger[]
  transferItems          TransferItem[]
  returnItems            GoodsReturnItem[]
  stocktakeLines         StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]
  stock                  BatchStock?
  reservations           StockReservation[]

  @@unique([tenantId, branchId, productId, batchNo])
  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, needsExpiryReview])
  @@index([tenantId, branchId, isQuarantined])
  @@index([tenantId, supplierId])
  @@map("batch")
}

model PurchaseOrder {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  branchId             String     @map("branch_id") @db.Uuid
  supplierId           String     @map("supplier_id") @db.Uuid
