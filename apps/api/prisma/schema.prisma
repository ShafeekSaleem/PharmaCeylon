generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  owner
  manager
  pharmacist
  cashier
  inventory_clerk
  analyst
}

enum PoStatus {
  draft
  pending_approval
  issued
  partially_received
  received
  short_closed
  cancelled
}

enum PoPriority {
  low
  normal
  high
  urgent
}

enum SaleStatus {
  posted
  voided
  refunded
}

enum TransferStatus {
  requested
  approved
  in_transit
  partially_received
  received
  rejected
  cancelled
}

enum GoodsReturnType {
  customer
  supplier
}

enum GoodsReturnStatus {
  draft
  pending_approval
  awaiting_logistics
  in_review
  completed
  rejected
  cancelled
}

enum StockMovementType {
  purchase_in
  sale_out
  customer_return_in
  supplier_return_out
  transfer_out
  transfer_in
  transfer_reserve_out
  transfer_reserve_release
  adjustment_in
  adjustment_out
  sale_void_in
  sale_refund_in
  quarantine_hold
  quarantine_release
  stocktake_in
  stocktake_out
}

enum StocktakeStatus {
  draft
  scheduled
  counting
  submitted
  under_review
  approved
  posted
  completed
  cancelled
}

enum StocktakeScope {
  full
  cycle
  near_expiry
  quarantined
  zero_stock
  custom
}

enum StocktakeMovementMode {
  continue_and_reconcile
  freeze_transactions
}

enum StocktakeCountStatus {
  pending
  counted
  submitted
  recount_requested
  recounted
  reviewed
  approved
  posted
}

enum StocktakeCondition {
  saleable
  damaged
  expired
  quarantined
  opened_pack
  missing_label
  temperature_affected
}

enum StocktakeVarianceReason {
  unrecorded_sale
  unrecorded_receipt
  damaged_stock
  expired_stock
  supplier_shortage
  wrong_batch_used
  unit_conversion_error
  transfer_not_recorded
  return_not_recorded
  counting_error
  suspected_theft_loss
  other
}

enum SupplierType {
  distributor
  importer
  manufacturer
  wholesaler
  other
}

enum SupplierStatus {
  active
  on_hold
  inactive
}

enum SupplierInvoiceStatus {
  open
  partial
  paid
  voided
}

/// Client-supplied idempotency keys (e.g. `Idempotency-Key` header) to avoid duplicate money mutations.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  scope          String   @db.VarChar(64)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId, scope, idempotencyKey])
  @@index([tenantId, scope, resourceId])
  @@map("idempotency_record")
}

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  legalName        String   @map("legal_name")
  displayName      String   @map("display_name")
  complianceRegion String   @map("compliance_region")
  timezone         String   @default("Asia/Colombo")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  branches          Branch[]
  users             AppUser[]
  userBranchRoles   UserBranchRole[]
  auditEvents       AuditEvent[]
  suppliers         Supplier[]
  supplierInvoices  SupplierInvoice[]

  @@map("tenant")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  timezone     String
  addressLine1 String?  @map("address_line1")
  city         String?
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userBranchRoles UserBranchRole[]
  batches         Batch[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  sales           Sale[]
  ledgerEntries   StockLedger[]
  transfersFrom   Transfer[]       @relation("TransferFromBranch")
  transfersTo     Transfer[]       @relation("TransferToBranch")
  goodsReturns      GoodsReturn[]
  stocktakes        Stocktake[]
  documentSequences DocumentSequence[]
  supplierInvoices  SupplierInvoice[]
  auditEvents       AuditEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branch")
}

model AppUser {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Globally unique — login resolves tenant from this email alone (subdomains may refine UX later).
  email     String   @unique
  fullName  String   @map("full_name")
  passwordHash String @map("password_hash")
  /// Bumped on logout-all, password change, role change, or detected refresh-reuse.
  /// Embedded in every access JWT; mismatch ⇒ 401.
  tokenVersion Int   @default(0) @map("token_version")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  userBranchRoles      UserBranchRole[]
  sessions             Session[]
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreator")
  goodsReceiptsReceived GoodsReceipt[]  @relation("GoodsReceiptReceiver")
  sales                Sale[]           @relation("SaleSeller")
  ledgerEntriesCreated StockLedger[]    @relation("StockLedgerActor")
  transfersRequested   Transfer[]       @relation("TransferRequester")
  transfersApproved    Transfer[]       @relation("TransferApprover")
  transfersReceived    Transfer[]       @relation("TransferReceiver")
  goodsReturnsRequested GoodsReturn[]   @relation("GoodsReturnRequester")
  goodsReturnsApproved  GoodsReturn[]   @relation("GoodsReturnApprover")
  goodsReturnsProcessed GoodsReturn[]   @relation("GoodsReturnProcessor")
  stocktakesCounted     Stocktake[]     @relation("StocktakeCounter")
  stocktakesAssigned    StocktakeAssignment[]
  stocktakesReviewed    Stocktake[]     @relation("StocktakeReviewer")
  stocktakesApproved    Stocktake[]     @relation("StocktakeApprover")
  stocktakesPosted      Stocktake[]     @relation("StocktakePoster")
  stocktakesCompleted   Stocktake[]     @relation("StocktakeCompleter")
  stocktakeCountEntries StocktakeCountEntry[]
  stocktakePostings     StocktakePosting[]
  stocktakeLineReviews  StocktakeLine[] @relation("StocktakeLineReviewer")
  stocktakeLineApprovals StocktakeLine[] @relation("StocktakeLineApprover")
  stocktakePostingLines StocktakePostingLine[]
  auditEvents          AuditEvent[]     @relation("AuditActor")

  @@index([tenantId])
  @@map("app_user")
}

/// Refresh-token-backed session. One row per issued refresh token.
/// Rotation: on refresh we create a new row sharing `familyId`, mark the old
/// row revoked with `replacedById` pointing at the new one. Reuse of a revoked
/// row triggers revocation of every row in the family.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  refreshTokenHash  String    @map("refresh_token_hash")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime? @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  replacedById      String?   @unique @map("replaced_by_id") @db.Uuid

  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   AppUser @relation(fields: [userId], references: [id])
  branch Branch  @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, branchId, role])
  @@map("user_branch_role")
}

model Supplier {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  code             String
  name             String
  type             SupplierType   @default(distributor)
  status           SupplierStatus @default(active)
  phone            String?
  email            String?
  contactName      String?        @map("contact_name")
  leadTimeDays     Int            @default(2) @map("lead_time_days")
  paymentTermsDays Int            @default(30) @map("payment_terms_days")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReturns   GoodsReturn[]
  invoices       SupplierInvoice[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("supplier")
}

model SupplierInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  supplierId     String                @map("supplier_id") @db.Uuid
  branchId       String?               @map("branch_id") @db.Uuid
  invoiceNumber  String                @map("invoice_number")
  goodsReceiptId String?               @unique @map("goods_receipt_id") @db.Uuid
  invoiceDate    DateTime              @map("invoice_date") @db.Date
  dueDate        DateTime              @map("due_date") @db.Date
  totalAmount    Decimal               @map("total_amount") @db.Decimal(14, 2)
  paidAmount     Decimal               @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status         SupplierInvoiceStatus @default(open)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("supplier_invoice")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sku          String
  barcode      String?
  name         String
  brandName    String?  @map("brand_name")
  genericName  String?  @map("generic_name")
  manufacturer String?
  dosageForm   String?  @map("dosage_form")
  strength     String?
  unit         String?
  packSize     String?  @map("pack_size")
  storage      String?
  shelfLife    String?  @map("shelf_life")
  taxCategory  String?  @map("tax_category")
  imageUrl     String?  @map("image_url")
  isControlled Boolean  @default(false) @map("is_controlled")
  reorderLevel Int      @default(0) @map("reorder_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  batches       Batch[]
  purchaseItems PurchaseOrderItem[]
  receiptItems  GoodsReceiptItem[]
  saleItems     SaleItem[]
  ledgerEntries StockLedger[]
  transferItems TransferItem[]
  returnItems   GoodsReturnItem[]
  stocktakeLines StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]
  tagMaps       ProductTagMap[]
  aliases       ProductAlias[]
  categoryMaps  ProductCategoryMap[]
  similarities  ProductSimilarity[] @relation("ProductSimilarityProduct")
  similarTo     ProductSimilarity[] @relation("ProductSimilaritySimilar")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@index([tenantId, brandName])
  @@index([tenantId, genericName])
  @@index([tenantId, name])
  @@map("product")
}

model ProductCategory {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  categoryMaps ProductCategoryMap[]

  @@unique([tenantId, name, parentCategoryId])
  @@index([tenantId, parentCategoryId])
  @@map("product_category")
}

model ProductTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tagMaps ProductTagMap[]

  @@unique([tenantId, name])
  @@map("product_tag")
}

model ProductTagMap {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, tagId])
  @@index([tenantId, productId])
  @@map("product_tag_map")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  aliasText String   @map("alias_text")
  aliasType String   @default("synonym") @map("alias_type")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, aliasText])
  @@index([tenantId, aliasText])
  @@map("product_alias")
}

model ProductSimilarity {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  similarProductId String   @map("similar_product_id") @db.Uuid
  score            Decimal  @db.Decimal(5, 4)
  reasonCode       String   @map("reason_code")
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product @relation("ProductSimilarityProduct", fields: [productId], references: [id], onDelete: Cascade)
  similarProduct Product @relation("ProductSimilaritySimilar", fields: [similarProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, similarProductId, reasonCode])
  @@map("product_similarity")
}

model ProductCategoryMap {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, categoryId])
  @@map("product_category_map")
}

model DocumentSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  docType   String   @map("doc_type") @db.VarChar(32)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, docType])
  @@map("document_sequence")
}

model Batch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  batchNo          String    @map("batch_no")
  expiryDate       DateTime  @db.Date @map("expiry_date")
  costPrice        Decimal   @db.Decimal(12, 2) @map("cost_price")
  sellingPrice     Decimal   @db.Decimal(12, 2) @map("selling_price")
  isQuarantined    Boolean   @default(false) @map("is_quarantined")
  quarantinedAt    DateTime? @map("quarantined_at")
  quarantineReason String?   @map("quarantine_reason") @db.VarChar(512)
  receivedAt       DateTime  @default(now()) @map("received_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  receiptItems   GoodsReceiptItem[]
  saleItems      SaleItem[]
  ledgerEntries  StockLedger[]
  transferItems  TransferItem[]
  returnItems    GoodsReturnItem[]
  stocktakeLines StocktakeLine[]
  stocktakeSnapshotLines StocktakeSnapshotLine[]

  @@unique([tenantId, branchId, productId, batchNo])
  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, isQuarantined])
  @@map("batch")
}

model PurchaseOrder {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  branchId             String     @map("branch_id") @db.Uuid
  supplierId           String     @map("supplier_id") @db.Uuid
  poNumber             String     @map("po_number")
  status               PoStatus   @default(draft)
  priority             PoPriority @default(normal)
  expectedOn           DateTime?  @db.Date @map("expected_on")
  supplierReference    String?    @map("supplier_reference") @db.VarChar(128)
  notes                String?
  deliveryInstructions String?    @map("delivery_instructions")
  paymentTermsDays     Int        @default(30) @map("payment_terms_days")
  shippingCharges      Decimal    @default(0) @db.Decimal(12, 2) @map("shipping_charges")
  createdBy            String     @map("created_by") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  branch   Branch   @relation(fields: [branchId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  creator  AppUser  @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  goodsReturns  GoodsReturn[]

  @@unique([tenantId, branchId, poNumber])
  @@index([tenantId, branchId, status])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  orderedQty      Int      @map("ordered_qty")
  unitCost        Decimal  @db.Decimal(12, 2) @map("unit_cost")
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  taxPercent      Decimal  @default(18) @db.Decimal(5, 2) @map("tax_percent")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_item")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  receivedOn      DateTime @db.Date @map("received_on")
  receivedBy      String   @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  branch        Branch        @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiver      AppUser       @relation("GoodsReceiptReceiver", fields: [receivedBy], references: [id])

  items           GoodsReceiptItem[]
  goodsReturns    GoodsReturn[]
  supplierInvoice SupplierInvoice?

  @@unique([tenantId, branchId, grnNumber])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  goodsReceiptId String   @map("goods_receipt_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  receivedQty    Int      @map("received_qty")
  createdAt      DateTime @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])

  @@map("goods_receipt_item")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  invoiceNo     String     @map("invoice_no")
  status        SaleStatus @default(posted)
  soldAt        DateTime   @default(now()) @map("sold_at")
  subtotal      Decimal    @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2) @map("tax_total")
  grandTotal    Decimal    @db.Decimal(12, 2) @map("grand_total")
  soldBy        String     @map("sold_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  branch Branch  @relation(fields: [branchId], references: [id])
  seller AppUser @relation("SaleSeller", fields: [soldBy], references: [id])

  items        SaleItem[]
  goodsReturns GoodsReturn[]

  @@unique([tenantId, branchId, invoiceNo])
  @@index([tenantId, branchId, soldAt(sort: Desc)])
  @@map("sale")
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  qty            Int
  unitPrice      Decimal  @db.Decimal(12, 2) @map("unit_price")
  discountAmount Decimal  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2) @map("tax_amount")
  lineTotal      Decimal  @db.Decimal(12, 2) @map("line_total")
  createdAt      DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@map("sale_item")
}

model StockLedger {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  batchId       String?           @map("batch_id") @db.Uuid
  movementType  StockMovementType @map("movement_type")
  qtyDelta      Int               @map("qty_delta")
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id") @db.Uuid
  reason        String?           @db.VarChar(512)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  branch  Branch   @relation(fields: [branchId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])
  actor   AppUser? @relation("StockLedgerActor", fields: [createdBy], references: [id])

  @@index([tenantId, branchId, productId, occurredAt(sort: Desc)])
  @@map("stock_ledger")
}

model Transfer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  fromBranchId   String         @map("from_branch_id") @db.Uuid
  toBranchId     String         @map("to_branch_id") @db.Uuid
  transferNumber String         @map("transfer_number")
  status         TransferStatus @default(requested)
  notes          String?
  expectedOn     DateTime?      @map("expected_on") @db.Date
  requestedBy    String         @map("requested_by") @db.Uuid
  approvedBy     String?        @map("approved_by") @db.Uuid
  receivedBy     String?        @map("received_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  fromBranch Branch   @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch   @relation("TransferToBranch", fields: [toBranchId], references: [id])
  requester  AppUser  @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver   AppUser? @relation("TransferApprover", fields: [approvedBy], references: [id])
  receiver   AppUser? @relation("TransferReceiver", fields: [receivedBy], references: [id])

  items TransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, fromBranchId, status])
  @@index([tenantId, toBranchId, status])
  @@map("transfer")
}

model TransferItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  transferId  String  @map("transfer_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid
  qty         Int
  receivedQty Int     @default(0) @map("received_qty")

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@map("transfer_item")
}

model GoodsReturn {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  returnNumber    String            @map("return_number")
  type            GoodsReturnType
  status          GoodsReturnStatus @default(draft)
  customerName    String?           @map("customer_name")
  saleId          String?           @map("sale_id") @db.Uuid
  supplierId      String?           @map("supplier_id") @db.Uuid
  purchaseOrderId String?           @map("purchase_order_id") @db.Uuid
  goodsReceiptId  String?           @map("goods_receipt_id") @db.Uuid
  reason          String?
  notes           String?
  amount          Decimal           @default(0) @db.Decimal(12, 2)
  requestedBy     String            @map("requested_by") @db.Uuid
  approvedBy      String?           @map("approved_by") @db.Uuid
  processedBy     String?           @map("processed_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  branch        Branch         @relation(fields: [branchId], references: [id])
  sale          Sale?          @relation(fields: [saleId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  requester     AppUser        @relation("GoodsReturnRequester", fields: [requestedBy], references: [id])
  approver      AppUser?       @relation("GoodsReturnApprover", fields: [approvedBy], references: [id])
  processor     AppUser?       @relation("GoodsReturnProcessor", fields: [processedBy], references: [id])

  items GoodsReturnItem[]

  @@unique([tenantId, branchId, returnNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@map("goods_return")
}

model GoodsReturnItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  returnId  String  @map("return_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  batchId   String? @map("batch_id") @db.Uuid
  qty       Int
  unitPrice Decimal @default(0) @db.Decimal(12, 2) @map("unit_price")

  goodsReturn GoodsReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  batch       Batch?      @relation(fields: [batchId], references: [id])

  @@map("goods_return_item")
}

model Stocktake {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  branchId             String                @map("branch_id") @db.Uuid
  stocktakeNumber      String                @map("stocktake_number")
  status               StocktakeStatus       @default(draft)
  scope                StocktakeScope        @default(full)
  movementMode         StocktakeMovementMode @default(continue_and_reconcile) @map("movement_mode")
  /// When true, counters do not see system qty until supervisor review.
  blindCount           Boolean               @default(false) @map("blind_count")
  /// Legacy mutable snapshot time retained for backfill compatibility.
  frozenAt             DateTime?             @map("frozen_at")
  /// Immutable baseline snapshot time used for reconciliation.
  snapshotAt           DateTime?             @map("snapshot_at")
  scheduledFor         DateTime?             @map("scheduled_for")
  expectedCompletionAt DateTime?             @map("expected_completion_at")
  nearExpiryDays       Int?                  @map("near_expiry_days")
  title                String?               @db.VarChar(160)
  areaLabel            String?               @map("area_label") @db.VarChar(160)
  notes                String?
  countedBy            String                @map("counted_by") @db.Uuid
  reviewerId           String?               @map("reviewer_id") @db.Uuid
  approvedBy           String?               @map("approved_by") @db.Uuid
  postedBy             String?               @map("posted_by") @db.Uuid
  completedBy          String?               @map("completed_by") @db.Uuid
  startedAt            DateTime?             @map("started_at")
  submittedAt          DateTime?             @map("submitted_at")
  reviewStartedAt      DateTime?             @map("review_started_at")
  approvedAt           DateTime?             @map("approved_at")
  postedAt             DateTime?             @map("posted_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  branch       Branch                  @relation(fields: [branchId], references: [id])
  counter      AppUser                 @relation("StocktakeCounter", fields: [countedBy], references: [id])
  reviewer     AppUser?                @relation("StocktakeReviewer", fields: [reviewerId], references: [id])
  approver     AppUser?                @relation("StocktakeApprover", fields: [approvedBy], references: [id])
  poster       AppUser?                @relation("StocktakePoster", fields: [postedBy], references: [id])
  completer    AppUser?                @relation("StocktakeCompleter", fields: [completedBy], references: [id])
  lines        StocktakeLine[]
  assignments  StocktakeAssignment[]
  snapshotLines StocktakeSnapshotLine[]
  countEntries StocktakeCountEntry[]
  postings     StocktakePosting[]

  @@unique([tenantId, branchId, stocktakeNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, scheduledFor])
  @@map("stocktake")
}

model StocktakeLine {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  stocktakeId      String                 @map("stocktake_id") @db.Uuid
  productId        String                 @map("product_id") @db.Uuid
  batchId          String                 @map("batch_id") @db.Uuid
  systemQty        Int                    @map("system_qty")
  countedQty       Int?                   @map("counted_qty")
  varianceQty      Int?                   @map("variance_qty")
  status           StocktakeCountStatus   @default(pending)
  condition        StocktakeCondition     @default(saleable)
  note             String?                @db.VarChar(512)
  reviewReason     StocktakeVarianceReason? @map("review_reason")
  reviewResolution String?                @map("review_resolution") @db.VarChar(512)
  reviewNote       String?                @map("review_note") @db.VarChar(512)
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  approvedBy       String?                @map("approved_by") @db.Uuid
  countedAt        DateTime?              @map("counted_at")
  reviewedAt       DateTime?              @map("reviewed_at")
  approvedAt       DateTime?              @map("approved_at")
  postedAt         DateTime?              @map("posted_at")

  stocktake    Stocktake             @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  batch        Batch                 @relation(fields: [batchId], references: [id])
  reviewer     AppUser?              @relation("StocktakeLineReviewer", fields: [reviewedBy], references: [id])
  approver     AppUser?              @relation("StocktakeLineApprover", fields: [approvedBy], references: [id])
  countEntries StocktakeCountEntry[]
  snapshotLine StocktakeSnapshotLine?
  postingLines StocktakePostingLine[]

  @@unique([stocktakeId, batchId])
  @@index([tenantId, stocktakeId, status])
  @@map("stocktake_line")
}

model StocktakeAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  areaLabel   String?  @map("area_label") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  user      AppUser   @relation(fields: [userId], references: [id])

  @@unique([stocktakeId, userId])
  @@index([tenantId, userId])
  @@map("stocktake_assignment")
}

model StocktakeSnapshotLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  lineId      String   @unique @map("line_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  snapshotQty Int      @map("snapshot_qty")
  createdAt   DateTime @default(now()) @map("created_at")

  stocktake Stocktake    @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  line      StocktakeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])
  batch     Batch        @relation(fields: [batchId], references: [id])

  @@unique([stocktakeId, batchId])
  @@index([tenantId, stocktakeId])
  @@map("stocktake_snapshot_line")
}

model StocktakeCountEntry {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  stocktakeId String              @map("stocktake_id") @db.Uuid
  lineId      String              @map("line_id") @db.Uuid
  countedQty  Int                 @map("counted_qty")
  condition   StocktakeCondition  @default(saleable)
  note        String?             @db.VarChar(512)
  isRecount   Boolean             @default(false) @map("is_recount")
  countedBy   String              @map("counted_by") @db.Uuid
  countedAt   DateTime            @default(now()) @map("counted_at")

  stocktake Stocktake    @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  line      StocktakeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  counter   AppUser      @relation(fields: [countedBy], references: [id])

  @@index([tenantId, stocktakeId, lineId, countedAt(sort: Desc)])
  @@map("stocktake_count_entry")
}

model StocktakePosting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  postedBy    String   @map("posted_by") @db.Uuid
  postedAt    DateTime @default(now()) @map("posted_at")
  note        String?  @db.VarChar(512)

  stocktake Stocktake             @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  poster    AppUser               @relation(fields: [postedBy], references: [id])
  lines     StocktakePostingLine[]

  @@index([tenantId, stocktakeId])
  @@map("stocktake_posting")
}

model StocktakePostingLine {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  postingId         String            @map("posting_id") @db.Uuid
  lineId            String            @map("line_id") @db.Uuid
  qtyDelta          Int               @map("qty_delta")
  movementType      StockMovementType @map("movement_type")
  ledgerReferenceId String            @map("ledger_reference_id") @db.Uuid
  reason            String?           @db.VarChar(512)
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         String            @map("created_by") @db.Uuid

  posting StocktakePosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  line    StocktakeLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  actor   AppUser          @relation(fields: [createdBy], references: [id])

  @@index([tenantId, postingId])
  @@index([tenantId, lineId])
  @@map("stocktake_posting_line")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventName   String   @map("event_name")
  entityName  String   @map("entity_name")
  entityId    String   @map("entity_id") @db.Uuid
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  actor  AppUser? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@map("audit_event")
}
