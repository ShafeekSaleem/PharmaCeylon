generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  owner
  manager
  pharmacist
  cashier
  inventory_clerk
  /**
   * Sentinel for a UserBranchRole mapping that points at a tenant-defined custom Role (see `roleId`).
   */
  custom
}

enum OwnerRegistrationStatus {
  pending_email
  verified
  expired
  completed
  cancelled
}

enum NotificationCategory {
  inventory
  expiry
  purchasing
  transfers
  stocktakes
  sales
  compliance
  system
}

enum NotificationSeverity {
  info
  warning
  critical
}

enum PoStatus {
  draft
  pending_approval
  issued
  partially_received
  received
  short_closed
  cancelled
}

enum PoPriority {
  low
  normal
  high
  urgent
}

enum SaleStatus {
  posted
  voided
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash
  card
  mobile_wallet
  credit
}

enum TransferStatus {
  requested
  approved
  in_transit
  partially_received
  received
  rejected
  cancelled
}

enum GoodsReturnType {
