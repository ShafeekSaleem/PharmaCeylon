  notes                String?
  deliveryInstructions String?    @map("delivery_instructions")
  paymentTermsDays     Int        @default(30) @map("payment_terms_days")
  shippingCharges      Decimal    @default(0) @map("shipping_charges") @db.Decimal(12, 2)
