{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  // Renderer unit tests run under jest in node and are typechecked by tsconfig.node.json.
  "exclude": ["src/renderer/**/*.spec.ts"]
}
