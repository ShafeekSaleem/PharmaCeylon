    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.12",
