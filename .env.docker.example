# Local Docker configuration only. Do not use these credentials in production.
POSTGRES_DB=pharmaceylon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Host port for the containerized NestJS API.
API_PORT=3001
WEB_ORIGINS=http://localhost:3000

# Next.js is reached by the browser through the host port. Its server-side
# proxy reaches NestJS through the private Compose service name.
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
API_PROXY_TARGET=http://api:3001

# Local-only values. Generate strong, independently managed secrets for any
# shared or deployed environment.
JWT_ACCESS_SECRET=local-docker-access-secret-change-before-production
JWT_REFRESH_SECRET=local-docker-refresh-secret-change-before-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
USER_CONTEXT_TTL_SECONDS=30

# Local observability and API documentation.
OPENAPI_ENABLED=true
STRUCTURED_HTTP_LOG=true
