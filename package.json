{
  "name": "pharmaceylon",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "npm run build -w @pharmaceylon/shared",
    "docker:config": "docker compose --env-file .env.docker config --quiet",
    "docker:build": "docker compose --env-file .env.docker build migrate api web",
    "docker:up": "docker compose --env-file .env.docker up -d --build --wait --wait-timeout 180 web",
    "docker:start": "docker compose --env-file .env.docker up -d --no-build --wait --wait-timeout 180 web",
    "docker:db": "docker compose --env-file .env.docker up -d db",
    "docker:ps": "docker compose --env-file .env.docker ps --all",
    "docker:logs": "docker compose --env-file .env.docker logs --follow --tail 100",
    "docker:stop": "docker compose --env-file .env.docker stop",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:migrate": "docker compose --env-file .env.docker run --rm migrate",
    "docker:check": "node scripts/docker/check-stack.mjs",
    "test:docker-scripts": "node --experimental-strip-types --test scripts/docker/check-stack.test.mjs scripts/docker/release-images.test.mjs",
    "docker:images:config": "node scripts/docker/images.mjs config",
    "docker:images:pull": "node scripts/docker/images.mjs pull",
    "docker:images:up": "node scripts/docker/images.mjs up",
    "docker:images:check": "node scripts/docker/images.mjs check",
    "docker:images:ps": "node scripts/docker/images.mjs ps",
    "docker:images:logs": "node scripts/docker/images.mjs logs",
    "docker:images:stop": "node scripts/docker/images.mjs stop",
    "docker:images:down": "node scripts/docker/images.mjs down"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.2.0",
    "sharp": "0.35.3",
    "js-yaml@4.1.1": "4.3.1",
    "postcss": "8.5.18",
    "detect-libc": "2.0.3",
    "mysql2": "3.24.3"
  }
}
